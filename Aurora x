				local track = new("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 42), BackgroundColor3 = T.bg1, BorderSizePixel = 0 }, { corner(3) })
				onThemeChange(function(k, c) if k == "bg1" then track.BackgroundColor3 = c end end)
				local fill = new("Frame", { Size = UDim2.new((value - min) / (max - min), 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(3) })
				accentGrad(fill, 0)
				fill.Parent = track
				local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(7) })
