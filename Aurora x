local sCfg = Settings:AddSection("Config")
do
	local HttpService = game:GetService("HttpService")
	local FILE = "AuroraX_UIConfigs.json"
	local canFile = type(writefile) == "function" and type(readfile) == "function"
	local store = { profiles = {}, last = nil, ask = true }
	local THEME_KEYS = { "bg0", "bg1", "side", "card", "row", "row2", "line", "text", "sub", "dim", "scroll" }
	local WHITE = Color3.new(1, 1, 1)

	-- dil destekli etiket: sozlukte varsa cevirir ve dil degisince gunceller (liste/popup tekrar tekrar olusturulur)
	local function lbl(p)
		p.BackgroundTransparency = 1
		p.Font = p.Font or Enum.Font.GothamMedium
		p.TextSize = p.TextSize or 13
		p.TextColor3 = p.TextColor3 or T.text
		p.TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Left
		local srcText = p.Text
		p.Text = T_(srcText)
		local l = new("TextLabel", p)
		regT(l, srcText)
		return l
	end

	------------------------------------------------ dosya islemleri
	if canFile then
		pcall(function()
			if type(isfile) == "function" and isfile(FILE) then
				local d = HttpService:JSONDecode(readfile(FILE))
				if type(d) == "table" then
					if type(d.profiles) == "table" then store.profiles = d.profiles end
					if type(d.last) == "string" then store.last = d.last end
					if d.ask == false then store.ask = false end
				end
			end
		end)
	end
	local warnedNoFile = false
	local function writeStore()
		if not canFile then
			if not warnedNoFile then
				warnedNoFile = true
				Aurora:Notify("Config", "No file system: saves last only for this session.", 5, "warn")
			end
			return false
		end
		return pcall(function()
			writefile(FILE, HttpService:JSONEncode({ profiles = store.profiles, last = store.last, ask = store.ask }))
		end)
	end

	------------------------------------------------ serilestirme
	local function colSer(c) return { r = c.R, g = c.G, b = c.B } end
	local function colDeser(t)
		if type(t) == "table" and t.r and t.g and t.b then return Color3.new(t.r, t.g, t.b) end
		return nil
	end
	local function ser(kind, v)
		if kind == "color" then return colSer(v) end
		if kind == "keybind" then
			if typeof(v) == "EnumItem" then
				return { kind = (v.EnumType == Enum.UserInputType) and "mouse" or "key", name = v.Name }
			elseif type(v) == "table" and v.value then
				return { kind = v.kind, name = v.value.Name }
			end
			return nil
		end
		return v
	end
	local function deser(kind, v)
		if kind == "color" then return colDeser(v) end
		if kind == "keybind" then
			if type(v) == "table" and v.name then
				local ok, e = pcall(function()
					if v.kind == "mouse" then return Enum.UserInputType[v.name] end
					return Enum.KeyCode[v.name]
				end)
				if ok and e then return { kind = v.kind, value = e } end
			end
			return nil
		end
		return v
	end

	local function captureTheme()
		local th = { accent = colSer(savedAccent), keys = {} }
		for _, k in ipairs(THEME_KEYS) do th.keys[k] = colSer(T[k]) end
		return th
	end
	local function applyTheme(th)
		if type(th) ~= "table" then return end
		local a = colDeser(th.accent)
		if a then Aurora:SetAccent(a, true) end
		if type(th.keys) == "table" then
			for _, k in ipairs(THEME_KEYS) do
				local c = colDeser(th.keys[k])
				if c then Aurora:UpdateThemeColor(k, c) end
			end
		end
	end

	local function capture()
		local items, on = {}, 0
		for _, e in ipairs(CTL.list) do
			local ok, v = pcall(e.get)
			if ok and v ~= nil then
				local sv = ser(e.kind, v)
				if sv ~= nil then
					table.insert(items, { k = e.key, v = sv })
					if e.kind == "toggle" and v == true then on = on + 1 end
				end
			end
		end
		return items, on
	end

	local applying = false
	local function applyProfile(name)
		local prof = store.profiles[name]
		if not prof or applying then return end
		applying = true
		task.spawn(function()
			pcall(applyTheme, prof.theme)
			local n = 0
			for i, it in ipairs(prof.items or {}) do
				local e = CTL.map[it.k]
				if e then
					local v = deser(e.kind, it.v)
					if v ~= nil and pcall(e.set, v) then n = n + 1 end
				end
				if i % 10 == 0 then task.wait() end
			end
			applying = false
			store.last = name
			writeStore()
			Aurora:Notify("Config loaded", name .. " - " .. n .. T_(" settings applied"), 3.5, "success")
		end)
	end

	------------------------------------------------ liste arayuzu
	local refresh
	local pendingRefresh = false
	local rowFrames = {}

	local selCfg = nil
	local function paintCfg()
		for _, rf in ipairs(rowFrames) do
			local st = rf.Parent and rf:FindFirstChildOfClass("UIStroke")
			if st then
				local on = selCfg == rf:GetAttribute("cfg")
				local last = rf:GetAttribute("last")
				tween(st, 0.18, { Color = (on or last) and accent or T.line, Transparency = on and 0 or (last and 0.35 or 0.55), Thickness = on and 2 or 1 })
			end
		end
	end

	local function makeRow(i, name, prof)
		local isLast = name == store.last
		local r = new("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = T.row, BorderSizePixel = 0, LayoutOrder = i }, { corner(12), stroke(isLast and accent or T.line, 1, isLast and 0.35 or 0.55) })
		r:SetAttribute("cfg", name)
		r:SetAttribute("last", isLast)
		table.insert(rowFrames, r)
		local pick = new("TextButton", { Text = "", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 1 })
		pick.MouseButton1Click:Connect(function()
			if selCfg == name then selCfg = nil else selCfg = name end
			paintCfg()
		end)
		pick.Parent = r

		local ic = new("Frame", { Size = UDim2.fromOffset(40, 40), Position = UDim2.fromOffset(12, 12), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(12) })
		accentGrad(ic, 45)
		new("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(4) }).Parent = ic
		new("Frame", { Size = UDim2.fromOffset(11, 6), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, -10), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(2) }).Parent = ic
		new("Frame", { Size = UDim2.fromOffset(11, 6), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.5, 8), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(2) }).Parent = ic
		ic.Parent = r

		lbl({ Text = name, Font = Enum.Font.GothamBold, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -190, 0, 20), Position = UDim2.fromOffset(62, 12) }).Parent = r
		lbl({
			Text = string.format("%d settings - %d on - %s", prof.n or 0, prof.on or 0, os.date("%d.%m %H:%M", prof.saved or os.time())),
			TextSize = 11, TextColor3 = T.dim, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -190, 0, 16), Position = UDim2.fromOffset(62, 34),
		}).Parent = r

		local load = new("TextButton", { Text = "", Size = UDim2.fromOffset(58, 28), Position = UDim2.new(1, -130, 0.5, -14), BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 3 }, { corner(10) })
		local loadFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1 }, { corner(10) })
		accentGrad(loadFill, 0)
		loadFill.Parent = load
		lbl({ Text = "LOAD", Font = Enum.Font.GothamBlack, TextSize = 11, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3 }).Parent = load
		load.Parent = r
		load.MouseButton1Click:Connect(function() applyProfile(name) end)

		local del = new("TextButton", { Text = "DELETE", Size = UDim2.fromOffset(58, 28), Position = UDim2.new(1, -68, 0.5, -14), BackgroundColor3 = T.row2, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = T.err, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 3 }, { corner(10), stroke(T.err, 1, 0.6) })
		del.Parent = r
		local armed = false
		del.MouseButton1Click:Connect(function()
			if not armed then
				armed = true
				del.Text = "SURE?"
				tween(del, 0.15, { BackgroundColor3 = T.err, TextColor3 = WHITE })
				task.delay(2, function()
					if armed and del.Parent then
						armed = false
						del.Text = "DELETE"
						tween(del, 0.15, { BackgroundColor3 = T.row2, TextColor3 = T.err })
					end
				end)
				return
			end
			armed = false
			store.profiles[name] = nil
			if store.last == name then
				local best, bt
				for n2, p2 in pairs(store.profiles) do
					if not bt or (p2.saved or 0) > bt then best, bt = n2, (p2.saved or 0) end
				end
				store.last = best
			end
			writeStore()
			Aurora:Notify("Config deleted", name, 3, "warn")
			refresh()
		end)
		return r
	end

	------------------------------------------------ bolum icerigi
	local nameText = ""
	sCfg:AddTextbox("Config name", "e.g. ESP on", function(txt) nameText = txt or "" end)
	sCfg:AddButton("Save Current UI", function()
		local nm = string.sub((nameText:gsub("^%s+", ""):gsub("%s+$", "")), 1, 24)
		if nm == "" then
			local c = 0
			for _ in pairs(store.profiles) do c = c + 1 end
			nm = "Config " .. (c + 1)
		end
		local items, on = capture()
		store.profiles[nm] = { saved = os.time(), items = items, on = on, n = #items, theme = captureTheme() }
		store.last = nm
		writeStore()
		Aurora:Notify("Config saved", nm .. " - " .. #items .. T_(" settings, ") .. on .. T_(" features on"), 3.5, "success")
		refresh()
	end)
