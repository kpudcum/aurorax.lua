	local ICON_KEYS = {
		{ "home", "home" }, { "player", "player" }, { "visual", "visuals" }, { "esp", "esp" },
		{ "aim", "aimbot" }, { "hit", "hitbox" }, { "setting", "settings" }, { "config", "settings" }, { "teleport", "teleport" },
	}
	local function tabIconKind(tabName)
		local lower = string.lower(tabName or "")
		for _, k in ipairs(ICON_KEYS) do
