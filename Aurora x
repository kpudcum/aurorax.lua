				onAccent(function(a) ks.Color = a end)
				ks.Parent = knob
				knob.Parent = fill
				track.Parent = r
				local function setRel(rel, fire)
					value = math.floor((min + (max - min) * rel) / step + 0.5) * step
					value = math.clamp(value, min, max)
					local shown = step < 1 and string.format("%.2f", value) or tostring(value)
					val.Text = shown
					tween(fill, 0.08, { Size = UDim2.new((value - min) / (max - min), 0, 1, 0) })
					if fire and cb then cb(value) end
				end
				makeDrag(track, function(rel) setRel(rel, true) end)
				local obj = {
					Set = function(v) setRel((v - min) / (max - min), true) end,
					Get = function() return value end,
				}
				regCtl(sid, t, "slider", obj.Get, obj.Set)
				return obj
			end

