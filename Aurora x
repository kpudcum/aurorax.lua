local CTL = { list = {}, map = {} }
local function regCtl(sid, lbl, kind, get, set)
	local k0 = sid .. "/" .. tostring(lbl)
	-- tema kontrolleri ayri yakalanir, config bolumunun kendisi kaydedilmez
	if sid == "Settings/Config" or sid == "Settings/Theme Packs & Backgrounds" or sid == "Settings/Theme Backgrounds"
		or k0 == "Settings/Appearance & Scale/Theme" or k0 == "Settings/Appearance & Scale/Custom accent" then
		return
	end
	local key, n = k0, 1
	while CTL.map[key] do
		n = n + 1
		key = k0 .. "#" .. n
	end
	local e = { key = key, kind = kind, get = get, set = set }
	CTL.map[key] = e
	table.insert(CTL.list, e)
end

