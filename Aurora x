			function Section:AddKeybind(t, default, cb)
				local key = default
				local listening = false
				local r = row(40, t)
				hover(r)
				label({ Text = t, Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(14, 0), TextColor3 = T.text }).Parent = r
				
				local function getBindName(b)
					if not b then return "None" end
					if type(b) == "table" then
						if b.kind == "mouse" then
							return (b.value == Enum.UserInputType.MouseButton2 and "Mouse 2") or (b.value == Enum.UserInputType.MouseButton3 and "Mouse 3") or "Mouse"
						elseif b.kind == "key" then
							return b.value.Name
						end
					elseif typeof(b) == "EnumItem" then
						return b.Name
					end
					return "None"
				end

				local kb = new("TextButton", { Text = getBindName(key), Size = UDim2.fromOffset(84, 26), Position = UDim2.new(1, -98, 0.5, -13), BackgroundColor3 = T.bg1, BackgroundTransparency = 0.3, Font = Enum.Font.Code, TextSize = 12, TextColor3 = T.sub, AutoButtonColor = false, BorderSizePixel = 0 }, { corner(8), stroke(T.line, 1, 0.3) })
				onThemeChange(function(k, c) if k == "bg1" then kb.BackgroundColor3 = c end end)
				kb.Parent = r
				
				kb.MouseButton1Click:Connect(function()
					if listening then return end
					listening = true
					kb.Text = "..."
					kb.TextColor3 = accent
				end)

				table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
					if listening then
						if i.UserInputType == Enum.UserInputType.Keyboard then
							if i.KeyCode ~= Enum.KeyCode.Escape and i.KeyCode ~= Enum.KeyCode.Unknown then
								listening = false
								key = { kind = "key", value = i.KeyCode }
								kb.Text = i.KeyCode.Name
								kb.TextColor3 = T.sub
								if cb then cb(key) end
							else
								listening = false
								kb.Text = getBindName(key)
								kb.TextColor3 = T.sub
							end
						elseif i.UserInputType == Enum.UserInputType.MouseButton2 or i.UserInputType == Enum.UserInputType.MouseButton3 then
							listening = false
							key = { kind = "mouse", value = i.UserInputType }
							kb.Text = (i.UserInputType == Enum.UserInputType.MouseButton2 and "Mouse 2") or "Mouse 3"
							kb.TextColor3 = T.sub
							if cb then cb(key) end
						end
					end
				end))
			end

