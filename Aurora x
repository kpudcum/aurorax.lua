local function setLine(f, x1, y1, x2, y2, c, th)
	if not (finite(x1) and finite(y1) and finite(x2) and finite(y2)) then f.Visible = false return end
	local dx, dy = x2 - x1, y2 - y1
	esp_lp[1], esp_lp[2], esp_lp[3], esp_lp[4] = -dx, dx, -dy, dy
	esp_lq[1], esp_lq[2], esp_lq[3], esp_lq[4] = x1, VW - x1, y1, VH - y1
	local t0, t1 = 0, 1
	for i = 1, 4 do
		if math.abs(esp_lp[i]) < 1e-5 then
			if esp_lq[i] < 0 then f.Visible = false return end
		else
			local t = esp_lq[i] / esp_lp[i]
			if esp_lp[i] < 0 then if t > t0 then t0 = t end else if t < t1 then t1 = t end end
			if t0 > t1 then f.Visible = false return end
		end
	end
	local ax, ay, bx, by = x1 + dx * t0, y1 + dy * t0, x1 + dx * t1, y1 + dy * t1
	local len = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
	if len < 1 then f.Visible = false return end
	f.BackgroundColor3 = c; f.Size = UDim2.fromOffset(len, th)
	f.Position = UDim2.fromOffset((ax + bx) * .5, (ay + by) * .5)
	f.Rotation = math.deg(math.atan2(by - ay, bx - ax)); f.Visible = true
end

