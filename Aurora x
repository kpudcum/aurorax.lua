-- 3b. TELEPORT SEKME
do
	local HttpService = game:GetService("HttpService")
	local TP = { Mode = "Instant", Time = 1.2, Lift = 3, Selected = nil, Back = nil, Filter = "", Click = false, SaveName = "", Coords = "" }
	local SAVE_FILE = "AuroraX_Teleports.json"
	local placeKey = tostring(game.PlaceId)
	local saved = {}
	pcall(function()
		if isfile and isfile(SAVE_FILE) then
			local all = HttpService:JSONDecode(readfile(SAVE_FILE))
			if type(all) == "table" and type(all[placeKey]) == "table" then saved = all[placeKey] end
		end
	end)
	local function persist()
		pcall(function()
			if not writefile then return end
			local all = {}
			if isfile and isfile(SAVE_FILE) then
				local ok, d = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE)) end)
				if ok and type(d) == "table" then all = d end
			end
			all[placeKey] = saved
			writefile(SAVE_FILE, HttpService:JSONEncode(all))
		end)
	end

	local function rootOf(plr)
		local c = plr and plr.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end
	local function say(msg, kind) Aurora:Notify("Teleport", msg, 2.5, kind or "success") end

	local tweenObj = nil
	local function goCF(cf, noLift)
		local r = rootOf(lp)
		if not r then say("Character not found", "error") return false end
		TP.Back = r.CFrame
		if tweenObj then tweenObj:Cancel() tweenObj = nil end
		local target = noLift and cf or (cf + Vector3.new(0, TP.Lift, 0))
		if TP.Mode == "Smooth" then
			tweenObj = TweenService:Create(r, TweenInfo.new(TP.Time, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { CFrame = target })
			tweenObj:Play()
		else
			pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
			r.CFrame = target
		end
		return true
	end
	local function goPlayer(p)
		local r = rootOf(p)
		if not p or not r then say("Player not found or has no character", "error") return end
		if goCF(r.CFrame * CFrame.new(0, 0, 3)) then say("Teleported to " .. p.DisplayName) end
	end

	local spectating = false
	local function stopSpec()
		spectating = false
		local cam = workspace.CurrentCamera
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if cam and h then cam.CameraSubject = h end
	end
	gui.Destroying:Connect(function() pcall(stopSpec) end)

	local Tele = Window:AddTab("Teleport", "o")

	------------------------------------------------ OYUNCULAR
	local tp1 = Tele:AddSection("Players")
	local refreshList
	tp1:AddTextbox("Search player", "name...", function(txt)
		TP.Filter = string.lower(txt or "")
		refreshList()
	end)
	local listBox = tp1:AddContainer()
	local entries = {}
	local accentObjs = {} -- accent rengini (rainbow dahil) takip edecek butonlar
	onAccent(function(a)
		for i = #accentObjs, 1, -1 do
			local o = accentObjs[i]
			if o.Parent then o.BackgroundColor3 = a else table.remove(accentObjs, i) end
		end
		for _, e in ipairs(entries) do
			if e.plr and e.plr == TP.Selected and e.st.Parent then e.st.Color = a end
		end
	end)
	local function paintSel()
		for _, e in ipairs(entries) do
			if e.plr and e.st.Parent then
				local on = TP.Selected == e.plr
				tween(e.st, 0.18, { Color = on and accent or T.line, Transparency = on and 0 or 0.5, Thickness = on and 2 or 1 })
			end
		end
	end
	refreshList = function()
		for _, e in ipairs(entries) do e.frame:Destroy() end
		entries = {}
		local plist = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp then
				local nm = string.lower(p.Name)
				local dn = string.lower(p.DisplayName)
				if TP.Filter == "" or string.find(nm, TP.Filter, 1, true) or string.find(dn, TP.Filter, 1, true) then table.insert(plist, p) end
			end
		end
		table.sort(plist, function(a, b) return string.lower(a.DisplayName) < string.lower(b.DisplayName) end)
		for n, p in ipairs(plist) do
			local f = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = T.row2, BackgroundTransparency = 0.3, AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = n }, { corner(10) })
			local st = stroke(T.line, 1, 0.5)
			st.Parent = f
			new("ImageLabel", { Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(8, 7), BackgroundColor3 = T.bg1, BorderSizePixel = 0, Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(p.UserId) .. "&w=60&h=60" }, { corner(17) }).Parent = f
			local nameL = label({ Text = p.DisplayName, Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, -170, 0, 18), Position = UDim2.fromOffset(52, 7) })
			nameL.TextTruncate = Enum.TextTruncate.AtEnd
			nameL.Parent = f
			local subL = label({ Text = "@" .. p.Name, TextSize = 11, TextColor3 = T.dim, Size = UDim2.new(1, -170, 0, 14), Position = UDim2.fromOffset(52, 26) })
			subL.TextTruncate = Enum.TextTruncate.AtEnd
			subL.Parent = f
			local dist = label({ Text = "--", TextSize = 11, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.fromOffset(56, 18), Position = UDim2.new(1, -122, 0, 15) })
			dist.Parent = f
			local go = new("TextButton", { Text = "TP", Size = UDim2.fromOffset(46, 28), Position = UDim2.new(1, -54, 0.5, -14), BackgroundColor3 = accent, Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, BorderSizePixel = 0 }, { corner(8) })
			go.Parent = f
			table.insert(accentObjs, go)
			f.MouseButton1Click:Connect(function()
				if TP.Selected == p then TP.Selected = nil else TP.Selected = p end
				paintSel()
			end)
			go.MouseButton1Click:Connect(function()
				TP.Selected = p
				paintSel()
				goPlayer(p)
			end)
			f.Parent = listBox
			table.insert(entries, { plr = p, frame = f, st = st, dist = dist })
		end
		if #plist == 0 then
			local e = label({ Text = "No players found", TextSize = 12, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30) })
			e.Parent = listBox
			table.insert(entries, { plr = nil, frame = e, st = { Color = T.line, Transparency = 0 }, dist = nil })
		end
		paintSel()
	end
	refreshList()
	table.insert(conns, Players.PlayerAdded:Connect(function() task.defer(refreshList) end))
	table.insert(conns, Players.PlayerRemoving:Connect(function(p)
		if TP.Selected == p then TP.Selected = nil end
		task.defer(refreshList)
	end))
	local distAcc = 0
	table.insert(conns, RunService.Heartbeat:Connect(function(dt)
		distAcc = distAcc + dt
		if distAcc < 0.5 then return end
		distAcc = 0
		local mine = rootOf(lp)
		for _, e in ipairs(entries) do
			if e.plr and e.dist then
				local r = rootOf(e.plr)
				e.dist.Text = (mine and r) and (tostring(math.floor((r.Position - mine.Position).Magnitude)) .. "m") or "--"
			end
		end
	end))

	tp1:AddButton("Teleport to Selected", function()
		if not TP.Selected then say("Tap a player in the list first", "warn") return end
		goPlayer(TP.Selected)
	end)
	tp1:AddButton("Teleport to Nearest Player", function()
		local mine = rootOf(lp)
		if not mine then say("Character not found", "error") return end
		local best, bd = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			local r = rootOf(p)
			if p ~= lp and r then
				local d = (r.Position - mine.Position).Magnitude
				if d < bd then best, bd = p, d end
			end
		end
		if best then goPlayer(best) else say("No player nearby", "warn") end
	end)
	tp1:AddButton("Teleport to Random Player", function()
		local pool = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and rootOf(p) then table.insert(pool, p) end
		end
		if #pool == 0 then say("No players", "warn") return end
		goPlayer(pool[math.random(1, #pool)])
	end)
	tp1:AddToggle("Spectate Selected", false, function(on)
		if on then
			local h = TP.Selected and TP.Selected.Character and TP.Selected.Character:FindFirstChildOfClass("Humanoid")
			if h and workspace.CurrentCamera then
				workspace.CurrentCamera.CameraSubject = h
				spectating = true
			else
				say("Select a player from the list first", "warn")
			end
		else
			stopSpec()
		end
	end)
	tp1:AddButton("Refresh List", function() refreshList() end)

	------------------------------------------------ KAYITLI KONUMLAR
	local tp2 = Tele:AddSection("Saved Locations")
	local refreshSaved
	tp2:AddTextbox("Location name", "e.g. Base", function(txt) TP.SaveName = txt or "" end)
	tp2:AddButton("Save Current Position", function()
		local r = rootOf(lp)
		if not r then say("Character not found", "error") return end
		local nm = TP.SaveName ~= "" and TP.SaveName or ("Spot " .. tostring(#saved + 1))
		local p = r.Position
		table.insert(saved, { name = nm, x = math.floor(p.X * 10) / 10, y = math.floor(p.Y * 10) / 10, z = math.floor(p.Z * 10) / 10 })
		persist()
		refreshSaved()
		say(T_("Saved: ") .. nm)
	end)
	local savedBox = tp2:AddContainer()
	local savedEntries = {}
	local selLoc, locStrokes = nil, {}
	local function paintLoc()
		for sv, st in pairs(locStrokes) do
			if st.Parent then
				local on = selLoc == sv
				tween(st, 0.18, { Color = on and accent or T.line, Transparency = on and 0 or 0.5, Thickness = on and 2 or 1 })
			end
		end
	end
	refreshSaved = function()
		for _, f in ipairs(savedEntries) do f:Destroy() end
		savedEntries = {}
		locStrokes = {}
		if #saved == 0 then
			local e = label({ Text = "No saved locations", TextSize = 12, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30) })
			e.Parent = savedBox
			table.insert(savedEntries, e)
