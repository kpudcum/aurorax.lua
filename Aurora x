local sPack = Settings:AddSection("Theme Packs & Backgrounds")
do
	local function hsvBG(h, sat)
		local function hv(v, k) return Color3.fromHSV(h, math.clamp(sat * (k or 1), 0, 1), v) end
		return { bg0 = hv(0.17), bg1 = hv(0.07), side = hv(0.09), card = hv(0.17), row = hv(0.22), row2 = hv(0.28), line = hv(0.34, 0.8),
			text = Color3.fromRGB(238, 241, 249), sub = hv(0.76, 0.15), dim = hv(0.55, 0.2), scroll = hv(0.34, 0.8) }
	end
	local BGS = {
		Black = hsvBG(0, 0), Midnight = hsvBG(0.62, 0.55), Crimson = hsvBG(0.99, 0.7), Forest = hsvBG(0.38, 0.6),
		Ocean = hsvBG(0.55, 0.65), Purple = hsvBG(0.76, 0.6), Rose = hsvBG(0.93, 0.55), Slate = hsvBG(0.6, 0.15), Coffee = hsvBG(0.07, 0.5),
		Teal = hsvBG(0.48, 0.6), Sunset = hsvBG(0.04, 0.65), Olive = hsvBG(0.2, 0.5),
		Light = { bg0 = Color3.fromRGB(240, 243, 250), bg1 = Color3.fromRGB(222, 228, 240), side = Color3.fromRGB(230, 234, 245), card = Color3.fromRGB(250, 251, 255),
			row = Color3.fromRGB(236, 240, 250), row2 = Color3.fromRGB(224, 229, 243), line = Color3.fromRGB(200, 208, 228), text = Color3.fromRGB(28, 32, 48),
			sub = Color3.fromRGB(80, 90, 120), dim = Color3.fromRGB(120, 130, 160), scroll = Color3.fromRGB(190, 198, 220) },
	}
	local BGORDER = { "Black", "Midnight", "Crimson", "Forest", "Ocean", "Purple", "Rose", "Slate", "Coffee", "Teal", "Sunset", "Olive", "Light" }
	local function applyBG(name)
		local t = BGS[name]
		if not t then return end
		for k, v in pairs(t) do Aurora:UpdateThemeColor(k, v) end
	end
	local PACKS = {
		Blood = { "Crimson", "Crimson" }, Ocean = { "Cyan", "Ocean" }, Sakura = { "Pink", "Rose" }, Matrix = { "Lime", "Black" },
		GoldBlack = { "Gold", "Black" }, NeonPurple = { "Magenta", "Purple" }, Forest = { "Emerald", "Forest" }, Sunset = { "Orange", "Sunset" },
		Ice = { "Sky", "Slate" }, Royal = { "Indigo", "Midnight" }, Coffee = { "Amber", "Coffee" }, Snow = { "Blue", "Light" },
	}
	sPack:AddDropdown("Theme Pack (renk + arka plan)", { "Blood", "Ocean", "Sakura", "Matrix", "GoldBlack", "NeonPurple", "Forest", "Sunset", "Ice", "Royal", "Coffee", "Snow" }, "Sec", function(o)
		local p = PACKS[o]
		if not p then return end
		Aurora:SetAccent(p[1], true)
		applyBG(p[2])
	end)
	sPack:AddDropdown("Background Preset", BGORDER, "Sec", function(o) applyBG(o) end)
end

