do
	local pnS = Settings:AddSection("Panic")
	local PN = { Key = { kind = "key", value = Enum.KeyCode.End }, Busy = false }
	local skipUntil = 0

	-- panic: tum ozellikleri kapatir, oyunun degerlerini geri yazar, arayuzu ve butun efektleri tamamen siler (sessiz, bildirim yok)
	local function panic()
		if PN.Busy then return end
		PN.Busy = true
		pcall(function()
			local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
			if hum then
				if walkSpeedEnabled then hum.WalkSpeed = Aurora.Orig.WalkSpeed or 16 end
				if jumpPowerEnabled then hum.JumpPower = Aurora.Orig.JumpPower or 50 end
			end
		end)
		pcall(function()
			walkSpeedEnabled, jumpPowerEnabled = false, false
			enforcedClockTime, enforcedAmbient = nil, nil
			Aim.Enabled = false
			Hit.Enabled = false
			Aurora.FlyFlag.On = false
			if FovLock.Value then
				FovLock.On = false
				workspace.CurrentCamera.FieldOfView = Aurora.Orig.FOV
			end
			workspace.Gravity = Aurora.Orig.Gravity
		end)
		-- gui yok edilince tum Destroying dinleyicileri calisir: fly/noclip/radar/crosshair/yagmur/gokyuzu/ESP/hitbox temizlenir
		pcall(function() gui:Destroy() end)
		pcall(function()
			for _, o in ipairs(host:GetChildren()) do
				if string.sub(o.Name, 1, 6) == "Aurora" then o:Destroy() end
			end
		end)
		warn("[Aurora] panic: script unloaded")
	end

	pnS:AddButton("PANIC - Unload Script", panic)
	if not AIM_MOBILE then
		pnS:AddKeybind("Panic Key", PN.Key, function(b)
			PN.Key = b
			skipUntil = os.clock() + 0.5 -- tusu atarken basilan tus panic'i tetiklemesin
		end)
		table.insert(conns, UIS.InputBegan:Connect(function(i)
			if os.clock() < skipUntil or UIS:GetFocusedTextBox() then return end
			if matchesKey(i, PN.Key) then panic() end
		end))
	end

	-- istege bagli yuzen panic butonu (mobil icin): dokun = panic, surukle = tasi
	local pb = new("TextButton", {
		Name = "PanicButton", Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = T.card, BackgroundTransparency = 0.1, BorderSizePixel = 0, Visible = false, ZIndex = 45,
	}, { corner(20) })
	local pbs = stroke(T.err, 2, 0.1)
	pbs.Parent = pb
	label({ Text = "!", Font = Enum.Font.GothamBlack, TextSize = 22, TextColor3 = T.err, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 46 }).Parent = pb
	local vp0 = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
	pb.Position = UDim2.fromOffset(vp0.X - 40, vp0.Y * 0.3)
	pb.Parent = gui
	do
		local pressed, dragged, startIn, startPos, mv = false, false, nil, Vector2.new(0, 0), nil
		pb.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
			pressed, dragged, startIn, mv = true, false, i.Position, i
			startPos = Vector2.new(pb.Position.X.Offset, pb.Position.Y.Offset)
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End and pressed then
					pressed = false
					if not dragged then panic() end
				end
			end)
		end)
		table.insert(conns, UIS.InputChanged:Connect(function(i)
			if not pressed or i ~= mv then return end
			local d = i.Position - startIn
			if not dragged and d.Magnitude >= 10 then dragged = true end
			if dragged then
				local v = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
				pb.Position = UDim2.fromOffset(math.clamp(startPos.X + d.X, 20, v.X - 20), math.clamp(startPos.Y + d.Y, 20, v.Y - 20))
			end
		end))
	end
	pnS:AddToggle("Floating Panic Button", false, function(on) pb.Visible = on end)
	pnS:AddLabel("Panic removes the UI, turns every feature off and restores the game's values. Run the script again to bring it back.")
end

