		AF.On = false
		if AF.Conn then AF.Conn:Disconnect() AF.Conn = nil end
	end
	gui.Destroying:Connect(afStop)
	sv2:AddToggle("Anti Fling", false, function(on)
		afStop()
		if not on then return end
		AF.On = true
		-- diger oyuncularin parcalari bizimle carpismaz (fling bu carpismayla calisir) + asiri hiz/donus sifirlanir
		AF.Conn = RunService.Stepped:Connect(function()
			for _, pl in ipairs(Players:GetPlayers()) do
				if pl ~= lp and pl.Character then
					for _, d in ipairs(pl.Character:GetDescendants()) do
						if d:IsA("BasePart") and d.CanCollide then d.CanCollide = false end
					end
				end
			end
			local char = lp.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and not Aurora.FlyFlag.On then
				local v = root.AssemblyLinearVelocity
				if Vector3.new(v.X, 0, v.Z).Magnitude > 120 or math.abs(v.Y) > 500 or root.AssemblyAngularVelocity.Magnitude > 60 then
					root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				end
			end
		end)
