	local rel = camCF:PointToObjectSpace(d.root.Position)
	local dir = Vector2.new(rel.X, -rel.Y)
	if dir.Magnitude < .01 then dir = Vector2.new(0, 1) end
	dir = dir.Unit
	local g = grp(d, 'arrow', buildArrow)
	local rad = math.min(VW, VH) * .42
	g.label.Position = UDim2.fromOffset(VW * .5 + dir.X * rad, VH * .5 + dir.Y * rad)
	g.label.Rotation = math.deg(math.atan2(dir.X, -dir.Y))
	g.label.TextColor3 = c
	show(g, true)
end

local function drawESP(d, cam, camCF)
	local r = d.root
	if not d.active or not r.Parent then hideTarget(d) return end
	local c = ESP.Rainbow and rainbow or d.color
	if ESP.Box3D then
		d.carrier.CFrame = r.CFrame * d.boxOff
		d.box3.Color3 = c; d.box3.LineThickness = .012 * ESP.Thickness + .015
		if not d.box3.Visible then d.box3.Visible = true end
	elseif d.box3.Visible then
		d.box3.Visible = false
	end

	local hlOn = ESP.Highlight and d.hlOK
	if d.hl.Enabled ~= hlOn then d.hl.Enabled = hlOn end
	if hlOn then d.hl.FillColor = c; d.hl.OutlineColor = c end

	local pos = r.Position
	local top = cam:WorldToViewportPoint(pos + Vector3.new(0, d.up, 0))
	local bot = cam:WorldToViewportPoint(pos - Vector3.new(0, d.down, 0))
	local front = top.Z > .2 and bot.Z > .2 and finite(top.X) and finite(top.Y) and finite(bot.X) and finite(bot.Y)
	local mx, y1, y2, x1, x2, w, h
	local onScr = false

	if front then
		mx = (top.X + bot.X) * .5
		y1 = math.min(top.Y, bot.Y); y2 = math.max(top.Y, bot.Y)
		h = y2 - y1; w = h * d.ratio; x1 = mx - w * .5; x2 = mx + w * .5
		onScr = h >= 2 and h < VH * 5 and x2 > -30 and x1 < VW + 30 and y2 > -30 and y1 < VH + 30
	end

	if ESP.Tracer and front then
		local g = grp(d, 'tracer', buildLine)
		local oy = (ESP.TracerFrom == 1 and VH) or (ESP.TracerFrom == 2 and VH * .5) or 0
		setLine(g.list[1], VW * .5, oy, mx, y2, c, 1.5)
	else
		show(d.g.tracer, false)
	end

	if not onScr then
		for k, g in pairs(d.g) do if k ~= 'arrow' and k ~= 'tracer' then show(g, false) end end
		drawArrow(d, camCF, c)
		return
	end

	show(d.g.arrow, false)
	x1, y1, x2, y2 = math.floor(x1 + .5), math.floor(y1 + .5), math.floor(x2 + .5), math.floor(y2 + .5)
	mx = math.floor(mx + .5); w = x2 - x1; h = y2 - y1
	local far = h < 30 or d.dist > 300
	local ts = ESP.TextSize
	if far then ts = math.max(8, ts - 2) end

	if ESP.Box then
		local g = grp(d, 'box', buildBox)
		local th = math.max(1, ESP.Thickness * .5)
		g.out.Position = UDim2.fromOffset(x1, y1); g.out.Size = UDim2.fromOffset(w, h)
		g.main.Position = UDim2.fromOffset(x1, y1); g.main.Size = UDim2.fromOffset(w, h)
		g.st.Color = c; g.st.Thickness = th
		g.main.BackgroundColor3 = c; g.main.BackgroundTransparency = ESP.Fill and .87 or 1
		show(g, true)
	else
		show(d.g.box, false)
	end

	if ESP.Corners then
		local g = grp(d, 'corners', buildCorners)
		local l = g.list
		local lx = math.clamp(math.floor(w * .28), 4, 24)
		local ly = math.clamp(math.floor(h * .2), 4, 24)
		local t = math.max(2, math.floor(ESP.Thickness * .7))
		put(l[1], x1, y1, lx, t, c); put(l[2], x1, y1, t, ly, c)
		put(l[3], x2 - lx, y1, lx, t, c); put(l[4], x2 - t, y1, t, ly, c)
		put(l[5], x1, y2 - t, lx, t, c); put(l[6], x1, y2 - ly, t, ly, c)
		put(l[7], x2 - lx, y2 - t, lx, t, c); put(l[8], x2 - t, y2 - ly, t, ly, c)
		show(g, true)
	else
		show(d.g.corners, false)
	end

	if ESP.Health and not far and h >= 26 then
		local g = grp(d, 'hp', buildHP)
		g.track.Position = UDim2.fromOffset(x1 - 7, y1); g.track.Size = UDim2.fromOffset(3, h)
		g.fill.Size = UDim2.fromScale(1, d.hp); g.fill.BackgroundColor3 = healthColor(d.hp)
		show(g, true)
	else
		show(d.g.hp, false)
	end

	if ESP.Name then
		local g = grp(d, 'name', buildLabel)
		local t = g.label
		t.Size = UDim2.fromOffset(240, ts + 4); t.Position = UDim2.fromOffset(mx - 120, y1 - ts - 6); t.TextSize = ts
		if t.Text ~= d.nameText then t.Text = d.nameText end
		show(g, true)
	else
		show(d.g.name, false)
	end

	local by = y2 + 2
	if ESP.Distance then
		local g = grp(d, 'dist', buildLabel)
		local t = g.label
		t.Size = UDim2.fromOffset(160, ts + 2); t.Position = UDim2.fromOffset(mx - 80, by); t.TextSize = ts - 1; t.TextColor3 = c
		if t.Text ~= d.distText then t.Text = d.distText end
		show(g, true); by = by + ts + 1
	else
		show(d.g.dist, false)
	end

	if (ESP.HeldItem or ESP.Inventory) and h >= 20 then
		local g = grp(d, 'inv', INV.build)
		INV.draw(d, g, mx, by + 2, ts, far, c)
	else
		show(d.g.inv, false)
	end

	if ESP.Skeleton and d.dist <= 350 and h >= 34 and d.bp then
		local g = grp(d, 'skel', buildSkel)
		table.clear(pcache)
		for i = 1, #g.list do
			local ln, pr = g.list[i], d.bp[i]
			if pr and pr[1].Parent and pr[2].Parent then
				local pa = pcache[pr[1]]
				if not pa then pa = cam:WorldToViewportPoint(pr[1].Position); pcache[pr[1]] = pa end
				local pb = pcache[pr[2]]
				if not pb then pb = cam:WorldToViewportPoint(pr[2].Position); pcache[pr[2]] = pb end
				if pa.Z > .2 and pb.Z > .2 then setLine(ln, pa.X, pa.Y, pb.X, pb.Y, c, 1.5) else ln.Visible = false end
			else
				ln.Visible = false
			end
		end
	else
		show(d.g.skel, false)
	end
end

