	onThemeChange(function(k, c) if k == "row" then head.BackgroundColor3 = c end end)
	lbl({ Text = "Saved Configs", Font = Enum.Font.GothamBold, TextSize = 13, Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(14, 0) }).Parent = head
	local countPill = new("Frame", { Size = UDim2.fromOffset(34, 22), Position = UDim2.new(1, -76, 0.5, -11), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(11) })
	accentGrad(countPill, 0)
	local countL = lbl({ Text = "0", Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	countL.Parent = countPill
	countPill.Parent = head
	local arrowL = lbl({ Text = "v", TextSize = 13, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(30, 42), Position = UDim2.new(1, -38, 0, 0) })
	arrowL.Parent = head
	head.Parent = cont
	local listBox = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Visible = false }, { list(6) })
	listBox.Parent = cont
	local listOpen = false
	head.MouseButton1Click:Connect(function()
		listOpen = not listOpen
		listBox.Visible = listOpen
		tween(arrowL, 0.2, { Rotation = listOpen and 180 or 0 })
	end)

	onThemeChange(function(k)
		if k == "row" or k == "text" or k == "sub" or k == "dim" or k == "bg0" or k == "err" then
			if pendingRefresh then return end
			pendingRefresh = true
			task.delay(0.2, function()
				pendingRefresh = false
				if refresh and listBox.Parent then refresh() end
			end)
		end
	end)

	refresh = function()
		for _, ch in ipairs(listBox:GetChildren()) do
			if ch:IsA("GuiObject") then ch:Destroy() end
		end
		rowFrames = {}
		local names = {}
		for n in pairs(store.profiles) do table.insert(names, n) end
		table.sort(names, function(a, b) return (store.profiles[a].saved or 0) > (store.profiles[b].saved or 0) end)
		countL.Text = tostring(#names)
		if #names == 0 then
			lbl({ Text = T_("No saved config yet. Turn on some features (e.g. ESP), type a name and press 'Save Current UI'."), TextSize = 11, TextColor3 = T.dim, TextWrapped = true, Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 0) }).Parent = listBox
			return
		end
		for i, n in ipairs(names) do
			local rf = makeRow(i, n, store.profiles[n])
			rf.Parent = listBox
		end
		if selCfg and not store.profiles[selCfg] then selCfg = nil end
		paintCfg()
	end
	-- listBox bos satir boyu 0: otomatik boyut icin etiket yuksekligi
	refresh()

	------------------------------------------------ acilista sorulan popup
	local function showPrompt(name)
		local prof = store.profiles[name]
		if not prof or not gui.Parent then return end
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		local fit = math.clamp(math.min((vp.X - 24) / 350, (vp.Y - 24) / 290), 0.5, 1)

		local overlay = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 200 })
		overlay.Parent = gui
		tween(overlay, 0.3, { BackgroundTransparency = 0.5 })

		local card = new("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(350, 272), BackgroundColor3 = T.bg0, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 201 }, { corner(20), stroke(accent, 1.6, 0.15) })
		local cs = new("UIScale", { Scale = fit * 0.85 })
		cs.Parent = card

		local band = new("Frame", { Size = UDim2.new(1, 0, 0, 92), BackgroundColor3 = WHITE, BorderSizePixel = 0 })
		accentGrad(band, 25)
		new("Frame", { Size = UDim2.fromOffset(130, 130), Position = UDim2.fromOffset(-34, -56), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88, BorderSizePixel = 0 }, { corner(65) }).Parent = band
		new("Frame", { Size = UDim2.fromOffset(96, 96), Position = UDim2.new(1, -64, 0, 26), BackgroundColor3 = WHITE, BackgroundTransparency = 0.9, BorderSizePixel = 0 }, { corner(48) }).Parent = band
		local icw = new("Frame", { Size = UDim2.fromOffset(60, 60), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BackgroundTransparency = 0.8, BorderSizePixel = 0 }, { corner(19), stroke(WHITE, 1.5, 0.5) })
		new("Frame", { Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, { corner(6) }).Parent = icw
		new("Frame", { Size = UDim2.fromOffset(16, 9), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, -15), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(3) }).Parent = icw
		new("Frame", { Size = UDim2.fromOffset(16, 9), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.5, 12), BackgroundColor3 = T.bg0, BorderSizePixel = 0, ZIndex = 2 }, { corner(3) }).Parent = icw
		icw.Parent = band
		band.Parent = card

		lbl({ Text = "SAVED CONFIG FOUND", Font = Enum.Font.GothamBlack, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 104) }).Parent = card
		lbl({ Text = "Do you want to load this config now?", TextSize = 12, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 127) }).Parent = card

		local chip = new("Frame", { Size = UDim2.new(1, -40, 0, 50), Position = UDim2.fromOffset(20, 152), BackgroundColor3 = T.row, BorderSizePixel = 0 }, { corner(12), stroke(T.line, 1, 0.4) })
		local dot = new("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(14, 21), BackgroundColor3 = accent, BorderSizePixel = 0 }, { corner(4) })
		dot.Parent = chip
		lbl({ Text = name, Font = Enum.Font.GothamBold, TextSize = 14, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -46, 0, 18), Position = UDim2.fromOffset(32, 8) }).Parent = chip
		lbl({ Text = string.format("%d settings - %d on - %s", prof.n or 0, prof.on or 0, os.date("%d.%m %H:%M", prof.saved or os.time())), TextSize = 11, TextColor3 = T.dim, TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -46, 0, 16), Position = UDim2.fromOffset(32, 27) }).Parent = chip
		chip.Parent = card

		local closed = false
		local function close(after)
			if closed then return end
			closed = true
			tween(cs, 0.2, { Scale = fit * 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(card, 0.2, { GroupTransparency = 1 })
			tween(overlay, 0.25, { BackgroundTransparency = 1 })
			task.delay(0.28, function()
				card:Destroy()
				overlay:Destroy()
				if after then after() end
			end)
		end

		local function mkBtn(text, x, primary, cb)
			local b = new("TextButton", {
				Text = "", Size = UDim2.fromOffset(150, 38), Position = UDim2.fromOffset(x, 214),
				AutoButtonColor = false, BorderSizePixel = 0, BackgroundTransparency = 1,
			}, { corner(12) })
			local bs = new("UIScale", { Scale = 1 })
			bs.Parent = b
			local txt = lbl({ Text = text, Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), ZIndex = 3 })
			-- EVET ve HAYIR ayni: tema renginde gradient dolgu (gradient yaziyi boyamasin diye ayri kutu)
			local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 1 }, { corner(12) })
			accentGrad(fill, 0)
			fill.Parent = b
			txt.Parent = b
			b.MouseEnter:Connect(function() tween(bs, 0.12, { Scale = 1.05 }) end)
			b.MouseLeave:Connect(function() tween(bs, 0.12, { Scale = 1 }) end)
			b.MouseButton1Click:Connect(cb)
			b.Parent = card
		end
		mkBtn(T_("YES, LOAD"), 20, true, function() close(function() applyProfile(name) end) end)
		mkBtn(T_("NO"), 180, false, function() close() end)

		local never = new("TextButton", { Text = T_("Don't ask again"), Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 254), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = T.dim, AutoButtonColor = false })
		never.MouseEnter:Connect(function() tween(never, 0.15, { TextColor3 = T.text }) end)
		never.MouseLeave:Connect(function() tween(never, 0.15, { TextColor3 = T.dim }) end)
		never.MouseButton1Click:Connect(function()
			askToggle.Set(false)
			Aurora:Notify("Config", "Ask-on-open is off. You can turn it on again in Settings > Config.", 4)
			close()
		end)
		never.Parent = card

		card.Parent = gui
		tween(cs, 0.45, { Scale = fit }, Enum.EasingStyle.Back)
		tween(card, 0.3, { GroupTransparency = 0 })
	end

	Window.AfterOpen = function()
		if not store.ask then return end
		local n = store.last
		if not n or not store.profiles[n] then return end
		task.wait(0.45)
		showPrompt(n)
	end
end

Window:Open()
return Aurora

end, function(e) return tostring(e) .. "\n" .. tostring(debug.traceback()) end)

if not __ok then
	-- Hata olursa: Output'a yaz, panoya kopyalamayi dene, ekranda kirmizi kutu goster
	warn("[Aurora] HATA: " .. tostring(__err))
	pcall(function()
		local clip = setclipboard or toclipboard
		clip("[Aurora error] " .. tostring(__err))
	end)
	pcall(function()
		local host
		local okH, h = pcall(function() return gethui() end)
		if okH and h then host = h else host = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end
		local g = Instance.new("ScreenGui")
		g.Name = "AuroraError"
		g.ResetOnSpawn = false
		g.IgnoreGuiInset = true
		g.DisplayOrder = 1000
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(0.5, 0.5)
		f.Size = UDim2.new(0.9, 0, 0, 260)
		f.BackgroundColor3 = Color3.fromRGB(30, 14, 18)
		f.BorderSizePixel = 0
		f.Parent = g
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 10)
		c.Parent = f
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(255, 90, 110)
		st.Thickness = 2
		st.Parent = f
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromOffset(14, 10)
		t.Size = UDim2.new(1, -28, 0, 22)
		t.Font = Enum.Font.GothamBold
		t.TextSize = 15
		t.TextColor3 = Color3.fromRGB(255, 130, 145)
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Text = "Aurora hata verdi (bu yaziyi gonder). Kapatmak icin dokun."
		t.Parent = f
		local m = Instance.new("TextLabel")
		m.BackgroundTransparency = 1
		m.Position = UDim2.fromOffset(14, 38)
		m.Size = UDim2.new(1, -28, 1, -48)
		m.Font = Enum.Font.Code
		m.TextSize = 13
		m.TextColor3 = Color3.fromRGB(255, 255, 255)
		m.TextWrapped = true
		m.TextXAlignment = Enum.TextXAlignment.Left
		m.TextYAlignment = Enum.TextYAlignment.Top
		m.TextSelectable = true
		m.Text = tostring(__err)
		m.Parent = f
		local b = Instance.new("TextButton")
		b.BackgroundTransparency = 1
		b.Size = UDim2.fromScale(1, 1)
		b.Text = ""
		b.ZIndex = 0
		b.Parent = f
		b.MouseButton1Click:Connect(function() g:Destroy() end)
		g.Parent = host
	end)
end
