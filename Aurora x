	end
	local nearLbl = label({ Text = "", TextSize = 10, Font = Enum.Font.GothamBold, TextColor3 = T.sub, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(0, 110, 0, 12), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 22), ZIndex = 46 })
	nearLbl.Parent = root
	local northLbl = label({ Text = "N", TextSize = 10, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(255, 110, 120), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(14, 12), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 46 })
