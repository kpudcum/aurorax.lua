		if acc >= 0.5 then
			acc = 0
			pcall(applyLight, SKY.Cur)
		end
		if fxPart then
			local cam = workspace.CurrentCamera
			if cam then
				if fxPart.Parent ~= cam then fxPart.Parent = cam end
				local up = fxPart:GetAttribute("up")
				fxPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, up and -8 or 40, 0))
			end
		end
	end))

	return {
		Order = ORDER,
		Set = function(n) pcall(setPreset, n) end,
		Reset = function() pcall(reset) end,
		SetClock = function(v)
			SKY.over.time = v
			Lighting.ClockTime = v
			enforcedClockTime = v
			if SKY.Cur then pcall(applyLight, SKY.Cur) end
		end,
		SetTime = function(on)
			SKY.useTime = on
			if SKY.Cur then pcall(applyLight, SKY.Cur) end
		end,
		SetParticles = function(on)
			SKY.Particles = on
			if SKY.Cur then pcall(fxBuild, SKY.Cur) end
		end,
		SetDensity = function(v)
			SKY.Density = v
			if fxEm and SKY.Cur and SKY.Cur.fx then fxEm.Rate = SKY.Cur.fx.rate * v end
		end,
		Over = function(k, v)
			SKY.over[k] = v
			if SKY.Cur then pcall(applyLight, SKY.Cur) end
		end,
	}
end)()

