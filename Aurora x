			end
		end
	end
	sc(model, true)
	if player then sc(player:FindFirstChildOfClass('Backpack'), false) end
	local names = {}
	for i = 1, math.min(24, #order) do
		local n = order[i]
		names[i] = count[n] > 1 and (n .. ' x' .. count[n]) or n
	end
	return held, names, #order
end

