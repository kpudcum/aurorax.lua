local ServerTab = Window:AddTab("Server", "o")
local sv1 = ServerTab:AddSection("Connection")
do
	local TeleportService = game:GetService("TeleportService")
	local HttpService = game:GetService("HttpService")
	local busy = false
	local function say(msg, kind) Aurora:Notify("Server", msg, 3, kind or "success") end

	local function httpGet(url)
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if ok and type(body) == "string" and #body > 2 then return body end
		local req = (syn and syn.request) or http_request or request or (http and http.request) or (fluxus and fluxus.request)
		if req then
			local ok2, res = pcall(function() return req({ Url = url, Method = "GET" }) end)
			if ok2 and res and res.Body then return res.Body end
		end
		return nil
	end

	sv1:AddButton("Rejoin", function()
		if busy then return end
		busy = true
		say("Reconnecting to the same server...", "warn")
		local ok = pcall(function()
			if #Players:GetPlayers() <= 1 then
				TeleportService:Teleport(game.PlaceId, lp)
			else
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
			end
		end)
		if not ok then say("Rejoin failed", "error") end
		task.delay(6, function() busy = false end)
	end)

	local function hop(smallest)
		if busy then return end
		busy = true
		task.spawn(function()
			say(smallest and "En bos sunucu araniyor..." or "Yeni sunucu araniyor...", "warn")
			local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=100", game.PlaceId, smallest and "Asc" or "Desc")
			local body = httpGet(url)
			local found = {}
			if body then
				local okJ, data = pcall(function() return HttpService:JSONDecode(body) end)
				if okJ and type(data) == "table" and type(data.data) == "table" then
					for _, sv in ipairs(data.data) do
						if sv.id ~= game.JobId and sv.playing and sv.maxPlayers and sv.playing < sv.maxPlayers - 1 then table.insert(found, sv) end
					end
				end
			end
			local ok
			if #found > 0 then
				local pick = smallest and found[1] or found[math.random(1, #found)]
				ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, lp) end)
				if ok then say(T_("Joining server (") .. tostring(pick.playing) .. T_(" players)")) end
			else
				ok = pcall(function() TeleportService:Teleport(game.PlaceId, lp) end)
				if ok then say("Could not get server list, hopping to a random server", "warn") end
			end
			if not ok then say("Server hop failed", "error") end
			task.delay(6, function() busy = false end)
		end)
	end
	sv1:AddButton("Server Hop (random)", function() hop(false) end)
	sv1:AddButton("Server Hop (emptiest server)", function() hop(true) end)
end

local sv1b = ServerTab:AddSection("Safezone")
do
	local SZ = { Height = 900, Built = false, CF = nil, Back = nil, Active = false }
	local platform, dome, glow = nil, nil, nil
	local function say(msg, kind) Aurora:Notify("Safezone", msg, 3, kind or "success") end

	local function rootOf(plr)
		local c = plr and plr.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end

	-- Platform + cevresinde hafif parlayan "guc alani" kabugu: tamamen bu istemciye ozel,
	-- bu yuzden baska hicbir oyuncu goremez ya da fiziksel olarak dokunamaz.
	local function buildPlatform(cf)
		local model = Instance.new("Model")
		model.Name = "AuroraSafezone"

		local base = Instance.new("Part")
		base.Name = "Platform"
		base.Shape = Enum.PartType.Cylinder
		base.Size = Vector3.new(2, 28, 28)
		base.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
		base.Anchored = true
		base.CanCollide = true
		base.Material = Enum.Material.Glass
		base.Color = T.bg0
		base.Parent = model
		onThemeChange(function(k, c2) if k == "bg0" then base.Color = c2 end end)

		local ring = Instance.new("Part")
		ring.Name = "Ring"
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.6, 29, 29)
		ring.CFrame = base.CFrame
		ring.Anchored = true
		ring.CanCollide = false
		ring.Material = Enum.Material.Neon
		ring.Color = accent
		ring.Transparency = 0.1
		ring.Parent = model
		onAccent(function(a) ring.Color = a end)

		local light = Instance.new("PointLight")
		light.Color = accent
		light.Range = 26
		light.Brightness = 2.2
		light.Parent = base
		onAccent(function(a) light.Color = a end)

		local shield = Instance.new("Part")
		shield.Name = "Shield"
		shield.Shape = Enum.PartType.Ball
		shield.Size = Vector3.new(46, 46, 46)
		shield.CFrame = cf
		shield.Anchored = true
		shield.CanCollide = false
		shield.CanQuery = false
		shield.Material = Enum.Material.ForceField
		shield.Transparency = 0.85
		shield.Color = accent
		shield.Parent = model
		onAccent(function(a) shield.Color = a end)

		model.Parent = workspace
		platform, dome, glow = base, shield, ring
		return model
	end

	local function clearPlatform()
		if platform and platform.Parent then platform.Parent:Destroy() end
		platform, dome, glow = nil, nil, nil
	end
	gui.Destroying:Connect(clearPlatform)

	sv1b:AddLabel("Creates one fixed spot high above the map and teleports you there. Out of normal players' reach.")
	sv1b:AddSlider("Safezone Height", 500, 10000, SZ.Height, function(v) SZ.Height = v end, 100)

	sv1b:AddButton("Go to Safezone", function()
		local r = rootOf(lp)
		if not r then say("Character not found", "error") return end
		if not SZ.Built then
			-- konum sadece ilk seferde belirlenir ve sabit kalir: "tek bir yer"
			SZ.CF = CFrame.new(r.Position + Vector3.new(0, SZ.Height, 0))
			buildPlatform(SZ.CF)
			SZ.Built = true
		end
		SZ.Back = r.CFrame
		SZ.Active = true
		pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
		r.CFrame = SZ.CF + Vector3.new(0, 4, 0)
		say("Teleported to the safezone")
	end)

	sv1b:AddButton("Rebuild Here", function()
		local r = rootOf(lp)
		if not r then say("Character not found", "error") return end
		clearPlatform()
		SZ.CF = CFrame.new(r.Position + Vector3.new(0, SZ.Height, 0))
		buildPlatform(SZ.CF)
		SZ.Built = true
		say("Safezone moved to a new spot above your current position", "warn")
	end)

	sv1b:AddButton("Return", function()
		if not SZ.Active or not SZ.Back then say("You have not used the safezone yet", "warn") return end
		local r = rootOf(lp)
		if not r then say("Character not found", "error") return end
		pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
		r.CFrame = SZ.Back
		SZ.Active = false
		say("Teleported back")
	end)
end

