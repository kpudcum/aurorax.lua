do
	local HttpService = game:GetService("HttpService")
	local TP = { Mode = "Instant", Time = 1.2, Lift = 3, Selected = nil, Back = nil, Filter = "", Click = false, SaveName = "", Coords = "" }
	local SAVE_FILE = "AuroraX_Teleports.json"
	local placeKey = tostring(game.PlaceId)
	local saved = {}
	pcall(function()
		if isfile and isfile(SAVE_FILE) then
			local all = HttpService:JSONDecode(readfile(SAVE_FILE))
			if type(all) == "table" and type(all[placeKey]) == "table" then saved = all[placeKey] end
		end
	end)
	local function persist()
		pcall(function()
			if not writefile then return end
			local all = {}
			if isfile and isfile(SAVE_FILE) then
				local ok, d = pcall(function() return HttpService:JSONDecode(readfile(SAVE_FILE)) end)
				if ok and type(d) == "table" then all = d end
			end
			all[placeKey] = saved
			writefile(SAVE_FILE, HttpService:JSONEncode(all))
		end)
	end

	local function rootOf(plr)
		local c = plr and plr.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end
	local function say(msg, kind) Aurora:Notify("Teleport", msg, 2.5, kind or "success") end

	local tweenObj = nil
	local function goCF(cf, noLift)
		local r = rootOf(lp)
		if not r then say("Karakter bulunamadi", "error") return false end
		TP.Back = r.CFrame
		if tweenObj then tweenObj:Cancel() tweenObj = nil end
		local target = noLift and cf or (cf + Vector3.new(0, TP.Lift, 0))
		if TP.Mode == "Smooth" then
			tweenObj = TweenService:Create(r, TweenInfo.new(TP.Time, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { CFrame = target })
			tweenObj:Play()
		else
			pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
			r.CFrame = target
		end
		return true
	end
	local function goPlayer(p)
		local r = rootOf(p)
		if not p or not r then say("Oyuncu bulunamadi veya karakteri yok", "error") return end
		if goCF(r.CFrame * CFrame.new(0, 0, 3)) then say(p.DisplayName .. " yanina isinlandin") end
	end

	local spectating = false
	local function stopSpec()
		spectating = false
		local cam = workspace.CurrentCamera
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if cam and h then cam.CameraSubject = h end
	end
