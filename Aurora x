	local function ensure(class, name)
		local o = Lighting:FindFirstChild(name)
		if o and not o:IsA(class) then o:Destroy() o = nil end
		if not o then
			o = Instance.new(class)
			o.Name = name
			o.Parent = Lighting
		end
		return o
	end
	local function hideForeign()
		for _, o in ipairs(Lighting:GetChildren()) do
			if (o:IsA("Sky") or o:IsA("Atmosphere")) and string.sub(o.Name, 1, 10) ~= "AuroraSky_" then
				table.insert(hidden, { o, o.Parent })
				o.Parent = nil
			end
		end
	end

	local function applyLight(p)
		local tm = SKY.over.time
		if tm == nil and SKY.useTime then tm = p.time end
		if tm ~= nil then
			Lighting.ClockTime = tm
			enforcedClockTime = tm
		else
			enforcedClockTime = nil
		end
		local a = ensure("Atmosphere", "AuroraSky_Atmo")
		a.Density = SKY.over.dens or p.atmo.d
		a.Offset = 0
		a.Color = SKY.over.acol or p.atmo.col
		a.Decay = SKY.over.dec or p.atmo.dec
		a.Glare = p.atmo.gl
		a.Haze = p.atmo.hz
		for _, n in ipairs({ "AuroraSky_CC", "AuroraSky_Bloom", "AuroraSky_Rays" }) do
			local o = Lighting:FindFirstChild(n)
			if o then o:Destroy() end
		end
		local sk = Lighting:FindFirstChild("AuroraSky_Sky")
		if sk and sk:GetAttribute("blank") ~= (p.blank and true or false) then sk:Destroy() end
		sk = ensure("Sky", "AuroraSky_Sky")
		sk:SetAttribute("blank", p.blank and true or false)
