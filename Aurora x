local fovStroke = fovCircle:FindFirstChildOfClass("UIStroke")
-- rainbow FOV: daire cercevesi donen gokkusagi gradyani ile boyanir (basi ve sonu ayni renk, dikissiz)
local fovGrad = new("UIGradient", { Enabled = false, Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 0.8, 1)), ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 0.8, 1)),
	ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 0.8, 1)), ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 0.8, 1)),
	ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 0.8, 1)), ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 0.8, 1)),
	ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 0.8, 1)),
}) })
fovGrad.Parent = fovStroke
onAccent(function(a) if not Aim.FOVColor or Aim.FOVColor == Color3.fromRGB(139, 108, 255) then fovStroke.Color = a end end)
fovCircle.Parent = gui

local aimRayParams = RaycastParams.new()
aimRayParams.FilterType = Enum.RaycastFilterType.Exclude
aimRayParams.IgnoreWater = true

local CLOSEST_PARTS = { "Head", "UpperTorso", "Torso", "LowerTorso", "HumanoidRootPart" }

local function matchesKey(input, b)
	if not b then return false end
	if type(b) == "table" then
		if b.kind == "mouse" then return input.UserInputType == b.value end
		if b.kind == "key" then return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == b.value end
	elseif typeof(b) == "EnumItem" then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == b
	end
	return false
end

local function isAiming()
	if not Aim.Enabled then return false end
	if Aim.Mode == "Always" then return true end
	if Aim.Mode == "Toggle" then return latched end
	return holding or btnHold
end

local function getCursor(cam)
	if UIS.TouchEnabled and not UIS.MouseEnabled then return cam.ViewportSize / 2 end
	return UIS:GetMouseLocation()
end

local function isVisibleAim(part, char, camPos)
	aimRayParams.FilterDescendantsInstances = lp.Character and { lp.Character } or {}
	local res = workspace:Raycast(camPos, part.Position - camPos, aimRayParams)
	return res == nil or res.Instance:IsDescendantOf(char)
end

local function pickAimPart(char, cursor, cam)
	if Aim.Part == "Head" then
		return char:FindFirstChild("Head")
	elseif Aim.Part == "Chest" then
		return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
	elseif Aim.Part == "Root" then
		return char:FindFirstChild("HumanoidRootPart")
	end
	local best, bestD
	for _, n in ipairs(CLOSEST_PARTS) do
		local p = char:FindFirstChild(n)
		if p and p:IsA("BasePart") then
			local v, on = cam:WorldToViewportPoint(p.Position)
			if on then
				local d = (Vector2.new(v.X, v.Y) - cursor).Magnitude
				if not bestD or d < bestD then best, bestD = p, d end
			end
		end
	end
	return best
end

-- NPC hedef listesi: sadece "NPCs" acikken doldurulur (workspace'teki oyuncu olmayan Humanoid modelleri)
local aimNpcs = {}
local function addAimNpc(h)
	local m = h and h.Parent
	if m and m:IsA("Model") and m ~= lp.Character and not Players:GetPlayerFromCharacter(m) then aimNpcs[m] = true end
end
local function scanAimNpcs()
	task.spawn(function()
		local all = workspace:GetDescendants()
		for i = 1, #all do
			if all[i]:IsA("Humanoid") then addAimNpc(all[i]) end
			if i % 800 == 0 then task.wait() end
		end
	end)
end
workspace.DescendantAdded:Connect(function(o)
	if Aim.NPC and o:IsA("Humanoid") then task.defer(addAimNpc, o) end
end)

-- char: oyuncu karakteri ya da NPC modeli
local function evaluateAim(char, cam, camPos, cursor, ignoreFov)
	if not char or not char.Parent then return nil end
	local plr = Players:GetPlayerFromCharacter(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	if plr and Aim.TeamCheck and plr.Team ~= nil and plr.Team == lp.Team then return nil end
	local part = pickAimPart(char, cursor, cam)
	if not part or not part:IsA("BasePart") then return nil end
	local dist = (part.Position - camPos).Magnitude
	if dist > Aim.MaxDistance then return nil end
	local point = part.Position + Vector3.new(0, Aim.YOffset, 0)
	if Aim.Prediction then
		point = point + part.AssemblyLinearVelocity * Aim.PredStrength
	end
	local v, on = cam:WorldToViewportPoint(point)
	if not on then return nil end
	local sd = (Vector2.new(v.X, v.Y) - cursor).Magnitude
	if not ignoreFov and sd > Aim.FOV then return nil end
	if Aim.WallCheck and not isVisibleAim(part, char, camPos) then return nil end
	return point, sd, dist, hum
end

RunService:BindToRenderStep("AimbotUI_Step", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local cursor = getCursor(cam)

	local showFov = Aim.Enabled and Aim.ShowFOV
	fovCircle.Visible = showFov
	if showFov then
		fovCircle.Position = UDim2.fromOffset(cursor.X, cursor.Y)
		fovCircle.Size = UDim2.fromOffset(Aim.FOV * 2, Aim.FOV * 2)
		if Aim.FOVRainbow then
			if not fovGrad.Enabled then fovGrad.Enabled = true end
			fovStroke.Color = Color3.new(1, 1, 1)
			fovGrad.Rotation = (os.clock() * 120) % 360
		else
			if fovGrad.Enabled then fovGrad.Enabled = false end
			fovStroke.Color = Aim.FOVColor
		end
	end

	local aiming = isAiming()
	local point
	if aiming then
		local camPos = cam.CFrame.Position
		if aimTarget and Aim.Sticky then
			local isPlr = Players:GetPlayerFromCharacter(aimTarget) ~= nil
			if (isPlr and Aim.Players) or (not isPlr and Aim.NPC) then
				point = evaluateAim(aimTarget, cam, camPos, cursor, true)
			end
		end
		if not point then
			aimTarget = nil
			local bestScore
			local function consider(ch)
				local p, sd, d, hum = evaluateAim(ch, cam, camPos, cursor, false)
				if p then
					local score = sd
					if Aim.Priority == "Closest distance" then
						score = d
					elseif Aim.Priority == "Lowest health" then
						score = hum.Health
					end
					if not bestScore or score < bestScore then
						bestScore, point, aimTarget = score, p, ch
					end
				end
			end
			if Aim.Players then
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr ~= lp and plr.Character then consider(plr.Character) end
				end
			end
			if Aim.NPC then
				for m in pairs(aimNpcs) do
					if not m.Parent or not m:IsDescendantOf(workspace) or Players:GetPlayerFromCharacter(m) then
						aimNpcs[m] = nil
					else
						consider(m)
					end
				end
			end
		end
		if point then
			local goal = CFrame.lookAt(camPos, point)
			if Aim.Smooth <= 0 then
				cam.CFrame = goal
			else
				local k = 1 + 39 * (1 - Aim.Smooth / 100) ^ 2
				cam.CFrame = cam.CFrame:Lerp(goal, 1 - math.exp(-dt * k))
			end
		end
	else
		aimTarget = nil
	end
end)

