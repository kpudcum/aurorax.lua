	end)
	tp1:AddButton("Teleport to Nearest Player", function()
		local mine = rootOf(lp)
		if not mine then say("Karakter bulunamadi", "error") return end
		local best, bd = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			local r = rootOf(p)
			if p ~= lp and r then
				local d = (r.Position - mine.Position).Magnitude
				if d < bd then best, bd = p, d end
			end
		end
		if best then goPlayer(best) else say("Yakinda oyuncu yok", "warn") end
	end)
	tp1:AddButton("Teleport to Random Player", function()
