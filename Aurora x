					if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
						if FC.up == dirv then FC.up = 0 end
					end
				end))
			end
			mkBtn("^", 170, 1)
			mkBtn("v", 95, -1)
		end
		return { root = sg, conns = conns2 }
	end

	local function step(dt)
		local cam = workspace.CurrentCamera
		if not cam then return end
		if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
		if UIS.TouchEnabled then pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default end) end
		local typing = UIS:GetFocusedTextBox() ~= nil
		local mx, mz, my, fast = FC.mv.X, -FC.mv.Y, FC.up, 1
		-- dokunmatik bakis (sag taraf surukleme)
		local dl = FC.look
		FC.look = Vector2.new(0, 0)
		FC.yaw = FC.yaw - math.rad(dl.X * FC.Sens * 1.4)
		FC.pitch = math.clamp(FC.pitch - math.rad(dl.Y * FC.Sens * 1.4), -1.5, 1.5)
		if not typing then
			if UIS:IsKeyDown(K.W) then mz = mz + 1 end
			if UIS:IsKeyDown(K.S) then mz = mz - 1 end
			if UIS:IsKeyDown(K.D) then mx = mx + 1 end
			if UIS:IsKeyDown(K.A) then mx = mx - 1 end
			if UIS:IsKeyDown(K.Space) or UIS:IsKeyDown(K.E) then my = my + 1 end
			if UIS:IsKeyDown(K.LeftControl) or UIS:IsKeyDown(K.Q) then my = my - 1 end
			if UIS:IsKeyDown(K.LeftShift) then fast = FC.Fast end
		end
		-- fare: sag tik basili tutarak bakilir (imlec kilitlenir), birakinca menu kullanilabilir
		local rmb = (not typing) and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
		if rmb ~= FC.rmb then
			FC.rmb = rmb
			UIS.MouseBehavior = rmb and Enum.MouseBehavior.LockCurrentPosition or Enum.MouseBehavior.Default
		end
		if rmb then
			local d = UIS:GetMouseDelta()
			FC.yaw = FC.yaw - math.rad(d.X * FC.Sens)
			FC.pitch = math.clamp(FC.pitch - math.rad(d.Y * FC.Sens), -1.5, 1.5)
		end
		local k = 40 - 0.35 * FC.Smooth
		local a = 1 - math.exp(-dt * k)
		FC.cyaw = FC.cyaw + (FC.yaw - FC.cyaw) * a
		FC.cpitch = FC.cpitch + (FC.pitch - FC.cpitch) * a
		local rot = CFrame.fromOrientation(FC.cpitch, FC.cyaw, 0)
		local dir = rot.LookVector * mz + rot.RightVector * mx + Vector3.new(0, my, 0)
		local target = Vector3.new(0, 0, 0)
		if dir.Magnitude > 0.01 then target = dir.Unit * math.min(dir.Magnitude, 1) * FC.Speed * fast end
		FC.vel = FC.vel:Lerp(target, 1 - math.exp(-dt * k * 0.6))
		FC.pos = FC.pos + FC.vel * dt
		cam.CFrame = CFrame.new(FC.pos) * rot
	end

	local function startFC()
		local cam = workspace.CurrentCamera
		if not cam or FC.On then return end
		FC.saved = { type = cam.CameraType, subject = cam.CameraSubject, cf = cam.CFrame }
		local rx, ry = cam.CFrame:ToOrientation()
		FC.pitch, FC.yaw, FC.cpitch, FC.cyaw = rx, ry, rx, ry
		FC.pos = cam.CFrame.Position
		FC.vel = Vector3.new(0, 0, 0)
		FC.mv, FC.up, FC.look, FC.rmb = Vector2.new(0, 0), 0, Vector2.new(0, 0), false
		FC.On = true
		cam.CameraType = Enum.CameraType.Scriptable
		-- menu acik kalirsa kontrolleri ortbasar: freecam acilirken menu gizlenir, kapaninca geri acilir
		FC.wasOpen = Window.IsOpen and Window.IsOpen() or false
		if FC.wasOpen and Window.SetOpen then Window.SetOpen(false) end
		local okUI, errUI = pcall(function() FC.ui = buildUI() end)
		if not okUI then Aurora:Notify("Freecam", "UI error: " .. tostring(errUI), 5, "error") end
		RunService:BindToRenderStep("AuroraFreecam", Enum.RenderPriority.Last.Value + 1, function(dt)
			local ok, e = pcall(step, dt)
			if not ok and not FC.warned then FC.warned = true warn("[Aurora] freecam: " .. tostring(e)) end
		end)
		-- karakter yerinde kalsin: oyun kontrolleri kapatilir (ayri thread, asla bloklamaz)
		task.spawn(function()
			pcall(function()
				CAS:BindActionAtPriority("AuroraFreecamSink", sink, false, Enum.ContextActionPriority.High.Value, K.W, K.A, K.S, K.D, K.Space, K.Q, K.E, K.LeftControl, K.LeftShift)
			end)
			local c = controls()
			FC.ctl = c
			if c and FC.On then pcall(function() c:Disable() end) end
		end)
	end
	stopFC = function()
		if not FC.On then return end
		FC.On = false
		pcall(function() RunService:UnbindFromRenderStep("AuroraFreecam") end)
		pcall(function() CAS:UnbindAction("AuroraFreecamSink") end)
		local c = FC.ctl or controls()
		FC.ctl = nil
		if c then pcall(function() c:Enable() end) end
		pcall(function() UIS.MouseBehavior = Enum.MouseBehavior.Default end)
		if FC.ui then
			for _, cn in ipairs(FC.ui.conns) do cn:Disconnect() end
			FC.ui.root:Destroy()
			FC.ui = nil
		end
		if FC.wasOpen and not FC.dying and Window.SetOpen then Window.SetOpen(true) end
		FC.wasOpen = false
		local cam = workspace.CurrentCamera
		if cam and FC.saved then
			cam.CameraType = (FC.saved.type == Enum.CameraType.Scriptable) and Enum.CameraType.Custom or FC.saved.type
			local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
			cam.CameraSubject = FC.saved.subject or hum
		end
	end
	gui.Destroying:Connect(function()
		FC.dying = true
		stopFC()
	end)

	fcToggle = fcS:AddToggle("Freecam", false, function(on)
		if on then
			local ok, err = pcall(startFC)
			if not ok then
				FC.On = true
				stopFC()
				Aurora:Notify("Freecam", "Error: " .. tostring(err), 5, "error")
			end
		else
			stopFC()
		end
	end)
	if not AIM_MOBILE then
		fcS:AddKeybind("Freecam Key", FC.Key, function(b)
			if type(b) == "table" then FC.Key = b end
			FC.skip = os.clock() + 0.5
		end)
		FC.skip = 0
		table.insert(conns, UIS.InputBegan:Connect(function(i)
			if os.clock() < FC.skip or UIS:GetFocusedTextBox() then return end
			if matchesKey(i, FC.Key) then fcToggle.Set(not fcToggle.Get()) end
		end))
	end
	fcS:AddSlider("Freecam Speed", 5, 300, 50, function(v) FC.Speed = v end)
	fcS:AddSlider("Fast Multiplier (Shift)", 1, 8, 3, function(v) FC.Fast = v end, 0.5)
	fcS:AddSlider("Smoothness", 0, 100, 35, function(v) FC.Smooth = v end)
	fcS:AddSlider("Look Sensitivity", 0.1, 1.5, 0.3, function(v) FC.Sens = v end, 0.05)
end

do
	local fbS = Visuals:AddSection("Fullbright")
	local FB = { On = false, Str = 0.75, Fog = true, Shadows = true, Conn = nil, Orig = nil, PrevEnf = nil, acc = 0 }
	local function put(prop, val)
		if Lighting[prop] ~= val then Lighting[prop] = val end
	end
	local function apply()
		local v = math.floor(255 * (0.35 + 0.65 * FB.Str))
		local c = Color3.fromRGB(v, v, v)
		enforcedAmbient = c
		put("OutdoorAmbient", c)
		put("Brightness", 1.5 + FB.Str * 1.5)
		if FB.Shadows then put("GlobalShadows", false) end
		if FB.Fog then
			put("FogEnd", 100000)
			put("FogStart", 0)
		end
	end
	local function stop()
		if FB.Conn then FB.Conn:Disconnect() FB.Conn = nil end
		if not FB.On then return end
		FB.On = false
		enforcedAmbient = FB.PrevEnf
		local o = FB.Orig
		if o then
			pcall(function()
				Lighting.Ambient = o.Ambient
				Lighting.OutdoorAmbient = o.OutdoorAmbient
				Lighting.Brightness = o.Brightness
				Lighting.GlobalShadows = o.GlobalShadows
				Lighting.FogEnd = o.FogEnd
				Lighting.FogStart = o.FogStart
			end)
		end
	end
	gui.Destroying:Connect(stop)
	fbS:AddToggle("Fullbright", false, function(on)
		if not on then
			stop()
			return
		end
		if FB.On then return end
		FB.Orig = { Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, Brightness = Lighting.Brightness,
			GlobalShadows = Lighting.GlobalShadows, FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart }
		FB.PrevEnf = enforcedAmbient
		FB.On = true
		apply()
		-- oyun isiklandirmayi geri yazarsa yarim saniyede bir tekrar uygula
		FB.Conn = RunService.Heartbeat:Connect(function(dt)
			FB.acc = FB.acc + dt
			if FB.acc >= 0.25 then
				FB.acc = 0
				pcall(apply)
			end
		end)
		Aurora:Notify("Fullbright", "Everything is fully lit", 2.5, "success")
	end)
	fbS:AddSlider("Fullbright Strength (%)", 10, 100, 75, function(v)
		FB.Str = v / 100
		if FB.On then pcall(apply) end
	end)
	fbS:AddToggle("Remove Fog", true, function(on) FB.Fog = on end)
	fbS:AddToggle("Remove Shadows", true, function(on) FB.Shadows = on end)
end

do
	local xhS = Visuals:AddSection("Crosshair")
	local XH = { On = false, Style = "Cross + Dot", Color = Color3.fromRGB(255, 255, 255), Rainbow = false, Accent = false, Len = 10, Gap = 4, Th = 2, Op = 1, Outline = true, Spin = false, Conn = nil }
	local accCol = Color3.fromRGB(139, 108, 255)
	onAccent(function(a) accCol = a end)

	local box = new("Frame", { Name = "AuroraCrosshair", Size = UDim2.fromOffset(240, 240), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Visible = false, ZIndex = 60 })
	local function bar()
		local b = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 61 })
		local st = new("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Transparency = 0.2 })
		st.Parent = b
		b.Parent = box
		return b, st
	end
	local bars, strokes = {}, {}
	for i = 1, 4 do bars[i], strokes[i] = bar() end
	local dot, dotSt = bar()
	corner(999).Parent = dot
	local ring = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 61 })
	corner(999).Parent = ring
	local ringSt = new("UIStroke", { Thickness = 2, Color = XH.Color })
	ringSt.Parent = ring
	local ringOut = new("UIStroke", { Color = Color3.fromRGB(0, 0, 0), Thickness = 1, Transparency = 0.2 })
	box.Parent = gui
	ring.Parent = box

	local function layout()
		local s = XH.Style
		local showBars = (s == "Cross" or s == "Cross + Dot")
		local showDot = (s == "Dot" or s == "Cross + Dot" or s == "Circle")
		local showRing = (s == "Circle")
		local L, G, T2 = XH.Len, XH.Gap, XH.Th
		local c = 120
		-- ust, alt, sol, sag
		bars[1].Size = UDim2.fromOffset(T2, L); bars[1].Position = UDim2.fromOffset(c, c - G - L / 2)
		bars[2].Size = UDim2.fromOffset(T2, L); bars[2].Position = UDim2.fromOffset(c, c + G + L / 2)
		bars[3].Size = UDim2.fromOffset(L, T2); bars[3].Position = UDim2.fromOffset(c - G - L / 2, c)
		bars[4].Size = UDim2.fromOffset(L, T2); bars[4].Position = UDim2.fromOffset(c + G + L / 2, c)
		local ds = math.max(2, T2 + 1)
		dot.Size = UDim2.fromOffset(ds, ds)
		dot.Position = UDim2.fromOffset(c, c)
		local rs = (G + L) * 2
		ring.Size = UDim2.fromOffset(rs, rs)
		ring.Position = UDim2.fromOffset(c, c)
		ringSt.Thickness = T2
		for i = 1, 4 do
			bars[i].Visible = showBars
			strokes[i].Enabled = XH.Outline
		end
		dot.Visible = showDot
		dotSt.Enabled = XH.Outline
		ring.Visible = showRing
		ringOut.Enabled = XH.Outline
	end
	local function paint(col)
		local tr = 1 - XH.Op
		for i = 1, 4 do
			bars[i].BackgroundColor3 = col
			bars[i].BackgroundTransparency = tr
		end
		dot.BackgroundColor3 = col
		dot.BackgroundTransparency = tr
		ringSt.Color = col
		ringSt.Transparency = tr
	end
	local function pick()
		if XH.Rainbow then return Color3.fromHSV((os.clock() * 0.3) % 1, 0.85, 1) end
		if XH.Accent then return accCol end
		return XH.Color
	end
	local function refresh()
		layout()
		paint(pick())
	end
	local function stop()
		if XH.Conn then XH.Conn:Disconnect() XH.Conn = nil end
	end
	gui.Destroying:Connect(stop)

	xhS:AddToggle("Crosshair", false, function(on)
		XH.On = on
		stop()
		box.Visible = on
		if not on then return end
		refresh()
		XH.Conn = RunService.Heartbeat:Connect(function()
			if XH.Rainbow or XH.Accent then paint(pick()) end
			box.Rotation = XH.Spin and ((os.clock() * 90) % 360) or 0
		end)
	end)
	xhS:AddDropdown("Crosshair Style", { "Cross", "Cross + Dot", "Dot", "Circle" }, "Cross + Dot", function(o)
		XH.Style = o
		refresh()
	end)
	xhS:AddColorPicker("Crosshair Color", XH.Color, function(c)
		XH.Color = c
		refresh()
	end)
	xhS:AddToggle("Rainbow", false, function(on) XH.Rainbow = on refresh() end)
	xhS:AddToggle("Use Accent Color", false, function(on) XH.Accent = on refresh() end)
	xhS:AddSlider("Length", 2, 40, 10, function(v) XH.Len = math.floor(v) refresh() end)
	xhS:AddSlider("Gap", 0, 24, 4, function(v) XH.Gap = math.floor(v) refresh() end)
	xhS:AddSlider("Thickness", 1, 6, 2, function(v) XH.Th = math.floor(v) refresh() end)
	xhS:AddSlider("Opacity (%)", 10, 100, 100, function(v) XH.Op = v / 100 refresh() end)
	xhS:AddToggle("Outline", true, function(on) XH.Outline = on refresh() end)
	xhS:AddToggle("Spin", false, function(on) XH.Spin = on end)
	refresh()
end

