			Lighting.FogEnd = orig.FogEnd
			Lighting.Brightness = orig.Brightness
			Lighting.ExposureCompensation = orig.Exposure
			Lighting.ClockTime = orig.ClockTime
		end
		enforcedAmbient = nil
		enforcedClockTime = nil
	end

	local function setPreset(name)
		if name == "Default" or not PRESETS[name] then
			reset()
			return
		end
		save()
		if #hidden == 0 then hideForeign() end
		local p = PRESETS[name]
		SKY.Cur = p
		SKY.Name = name
		applyLight(p)
		fxBuild(p)
