	-- 20x20 alana simge cizer, renk degistirme fonksiyonu dondurur
	local function buildTabIcon(kind, parent)
		local fills, strokes = {}, {}
		local box = new("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1 })
		local function round(f, r)
			if r == "c" then
				new("UICorner", { CornerRadius = UDim.new(0.5, 0) }).Parent = f
			elseif r then
				new("UICorner", { CornerRadius = UDim.new(0, r) }).Parent = f
			end
		end
		local function rect(x, y, w, h, r, rot) -- dolu parca
			local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = T.dim, BorderSizePixel = 0, Rotation = rot or 0 })
			round(f, r)
			f.Parent = box
			table.insert(fills, f)
		end
		local function ring(x, y, w, h, r, thick) -- cizgi (ici bos) parca
			local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, BorderSizePixel = 0 })
			round(f, r)
			local st = new("UIStroke", { Thickness = thick or 1.6, Color = T.dim, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
			st.Parent = f
			f.Parent = box
			table.insert(strokes, st)
		end

		if kind == "home" then
			rect(4, 10, 12, 8, 2)
			rect(4, 2, 12, 12, 2, 45)
		elseif kind == "player" then
			rect(6, 1, 8, 8, "c")
			rect(3, 11, 14, 8, 4)
		elseif kind == "visuals" then
			ring(2, 5, 16, 10, 5, 1.6)
			rect(7, 7, 6, 6, "c")
		elseif kind == "esp" then
			rect(2, 2, 6, 2) rect(2, 2, 2, 6)
			rect(12, 2, 6, 2) rect(16, 2, 2, 6)
			rect(2, 16, 6, 2) rect(2, 12, 2, 6)
			rect(12, 16, 6, 2) rect(16, 12, 2, 6)
			rect(8, 8, 4, 4, "c")
		elseif kind == "aimbot" then
			ring(3, 3, 14, 14, "c", 1.6)
			rect(9, 0, 2, 5) rect(9, 15, 2, 5)
			rect(0, 9, 5, 2) rect(15, 9, 5, 2)
			rect(8, 8, 4, 4, "c")
		elseif kind == "hitbox" then
			ring(2, 7, 10, 10, 2, 1.6)
			ring(8, 2, 10, 10, 2, 1.6)
		elseif kind == "teleport" then
			ring(5, 1, 10, 18, "c", 1.6)
			ring(8, 5, 4, 10, "c", 1.4)
		elseif kind == "settings" then
			rect(2, 4, 7, 2, 1) rect(11, 2, 6, 6, "c")
			rect(12, 9, 6, 2, 1) rect(4, 7, 6, 6, "c")
			rect(2, 14, 8, 2, 1) rect(12, 12, 6, 6, "c")
		end

		box.Parent = parent
		return function(c)
			for _, f in ipairs(fills) do f.BackgroundColor3 = c end
			for _, st in ipairs(strokes) do st.Color = c end
		end
	end

