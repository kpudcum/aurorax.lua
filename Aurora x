		local nm = selCfg
		if not nm or not store.profiles[nm] then
			Aurora:Notify("Config", "Select a config from the list first", 3, "warn")
			return
		end
		-- yanlislikla ustune yazmamak icin: ilk basista uyar, 4 sn icinde tekrar basinca kaydet
		if owArm ~= nm then
			owArm = nm
