local Hit = {
	Enabled = false,
	Groups = { Head = false, Torso = false, Root = false, Arms = false, Legs = false },
	Uniform = true,
	Scale = 2,
	SX = 2, SY = 2, SZ = 2,
	ShowBox = false,
	Transparency = 0.5,
	Color = Color3.fromRGB(255, 60, 60),
	Neon = false,
	NoCollide = false,
	TeamCheck = false,
	MaxDistance = 2000,
}

local PART_GROUPS = {
	Head = { "Head" },
	Torso = { "UpperTorso", "LowerTorso", "Torso" },
	Root = { "HumanoidRootPart" },
	Arms = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "Left Arm", "Right Arm" },
	Legs = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "Left Leg", "Right Leg" },
}
local GROUP_ORDER = { "Head", "Torso", "Root", "Arms", "Legs" }
local records = {}

local function getScale()
	if Hit.Uniform then return Hit.Scale, Hit.Scale, Hit.Scale end
	return Hit.SX, Hit.SY, Hit.SZ
end

local function restorePart(part, o)
	if not part or not part.Parent then return end
	pcall(function()
		part.Size = o.Size
		part.Transparency = o.Transparency
		part.Color = o.Color
		part.Material = o.Material
		part.CanCollide = o.CanCollide
		if o.Massless ~= nil then part.Massless = o.Massless end
		if o.CanQuery ~= nil then part.CanQuery = o.CanQuery end
		if o.Motor and o.Motor.Parent then o.Motor.C1 = o.C1 end
	end)
end

local function restoreAll(rec)
	for part, o in pairs(rec.parts) do restorePart(part, o) end
	rec.parts = {}
end

local function applyPart(rec, part, sx, sy, sz)
	local o = rec.parts[part]
	if not o then
		o = { Size = part.Size, Transparency = part.Transparency, Color = part.Color, Material = part.Material, CanCollide = part.CanCollide, Massless = part.Massless, CanQuery = part.CanQuery }
		-- eklem (Motor6D) sabit kaldigi icin buyuyen kafa govdeye gomuluyordu: eklemi buyume kadar kaydir
		for _, m in ipairs(rec.char:GetDescendants()) do
			if m:IsA("Motor6D") and m.Part1 == part then
				o.Motor, o.C1 = m, m.C1
				break
			end
		end
		rec.parts[part] = o
	end
	local want = Vector3.new(o.Size.X * sx, o.Size.Y * sy, o.Size.Z * sz)
	if (part.Size - want).Magnitude > 0.01 then part.Size = want end
	if o.Motor and o.Motor.Parent and part.Name == "Head" then
		local c1 = o.C1 * CFrame.new(0, -(want.Y - o.Size.Y) / 2, 0)
		if o.Motor.C1 ~= c1 then o.Motor.C1 = c1 end
	end
	pcall(function() part.Massless = true end)
	part.CanQuery = true
	part.CanTouch = true

	local tr, col, mat = o.Transparency, o.Color, o.Material
	if Hit.ShowBox then
		tr, col = Hit.Transparency, Hit.Color
		if Hit.Neon then mat = Enum.Material.Neon end
	end
	if part.Transparency ~= tr then part.Transparency = tr end
	if part.Color ~= col then part.Color = col end
	if part.Material ~= mat then part.Material = mat end

	local cc = o.CanCollide
	if Hit.NoCollide then cc = false end
	if part.CanCollide ~= cc then part.CanCollide = cc end
end

local hitAcc = 0
RunService.Heartbeat:Connect(function(dt)
	hitAcc = hitAcc + dt
	if hitAcc < 0.1 then return end
	hitAcc = 0
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	local sx, sy, sz = getScale()

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp then
			local char = plr.Character
			local rec = records[plr]
			if rec and rec.char ~= char then
				rec = nil
				records[plr] = nil
			end

			local eligible = false
			if Hit.Enabled and char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				local root = char:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and root then
					eligible = true
					if Hit.TeamCheck and plr.Team ~= nil and plr.Team == lp.Team then eligible = false end
					if eligible and camPos and (root.Position - camPos).Magnitude > Hit.MaxDistance then eligible = false end
				end
			end

			if eligible then
				if not rec then
					rec = { char = char, parts = {} }
					records[plr] = rec
				end
				local desired = {}
				for _, gname in ipairs(GROUP_ORDER) do
					if Hit.Groups[gname] then
						for _, pname in ipairs(PART_GROUPS[gname]) do
							local part = char:FindFirstChild(pname)
							if part and part:IsA("BasePart") then desired[part] = true end
						end
					end
				end
				for part, o in pairs(rec.parts) do
					if not desired[part] then
						restorePart(part, o)
						rec.parts[part] = nil
					end
				end
				for part in pairs(desired) do
					applyPart(rec, part, sx, sy, sz)
				end
			elseif rec then
				restoreAll(rec)
				records[plr] = nil
			end
		end
	end
end)

