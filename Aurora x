local function measure(d)
	local r = d.root
	local ok, cf, size = pcall(function() return d.model:GetBoundingBox() end)
	local off, sx, sy, sz = CFrame.new(), 4, 6, 2
	if ok and cf and size and finite(size.X) and finite(size.Y) and finite(size.Z) then
		local o = r.CFrame:ToObjectSpace(cf)
		if o.Position.Magnitude < 8 then
			off = o; sx = math.clamp(size.X + .2, 2, 7); sy = math.clamp(size.Y + .2, 3, 10); sz = math.clamp(size.Z + .2, 1.5, 7)
		end
	end
	local ns = Vector3.new(sx, sy, sz)
	if d.boxSize then ns = d.boxSize:Lerp(ns, .35); off = d.boxOff:Lerp(off, .35) end
	d.boxSize, d.boxOff = ns, off
	d.carrier.Size = ns
	local cy = (r.CFrame * off).Position.Y
	d.up = math.clamp(cy + ns.Y * .5 - r.Position.Y, 1, 8)
	d.down = math.clamp(r.Position.Y - (cy - ns.Y * .5), 1, 8)
	d.ratio = math.clamp(ns.X * .8 / ns.Y, .38, .62)
end

local function buildBones(d)
	local m = d.model
