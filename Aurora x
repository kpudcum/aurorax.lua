	-- gokyuzunde dallanip budaklanan gercek simsek: kameranin etrafinda uzak bir noktaya, titreyerek soner
	local function rainBolt()
		local cam = workspace.CurrentCamera
		if not cam then return 700 end
		local cp = cam.CFrame.Position
		local ang = math.random() * math.pi * 2
		local dist = 650 + math.random() * 500
		local base = cp + Vector3.new(math.cos(ang) * dist, 0, math.sin(ang) * dist)
		local top = base + Vector3.new(math.random(-80, 80), 430, math.random(-80, 80))
		local bot = Vector3.new(base.X, rain.gy or (cp.Y - 4), base.Z)
		local N = 14
		local pts = {}
		for i = 0, N do
			local p = top:Lerp(bot, i / N)
			if i > 0 and i < N then
				local j = 38 * (1 - i / N * 0.5)
				p = p + Vector3.new((math.random() - 0.5) * 2 * j, 0, (math.random() - 0.5) * 2 * j)
			end
			pts[i + 1] = p
		end
		local model = Instance.new("Folder")
		model.Name = "AuroraBolt"
		local parts = {}
		local function seg(a, b, w)
			local len = (b - a).Magnitude
			local pt = Instance.new("Part")
			pt.Anchored = true
			pt.CanCollide = false
			pt.CanQuery = false
			pt.CanTouch = false
			pt.CastShadow = false
			pt.Material = Enum.Material.Neon
			pt.Color = Color3.fromRGB(205, 222, 255)
			pt.Size = Vector3.new(w, w, len)
			pt.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -len / 2)
			pt.Parent = model
			table.insert(parts, pt)
		end
		for i = 1, N do seg(pts[i], pts[i + 1], 5) end
		local prev = pts[math.random(4, 9)]
		for i = 1, 4 do
			local nx = prev + Vector3.new((math.random() - 0.5) * 90, -55, (math.random() - 0.5) * 90)
			seg(prev, nx, 2.5)
			prev = nx
		end
		model.Parent = cam
		task.delay(0.07, function() for _, p in ipairs(parts) do if p.Parent then p.Transparency = 0.75 end end end)
		task.delay(0.13, function() for _, p in ipairs(parts) do if p.Parent then p.Transparency = 0 end end end)
		task.delay(0.22, function() for _, p in ipairs(parts) do if p.Parent then tween(p, 0.35, { Transparency = 1 }) end end end)
		task.delay(0.7, function() model:Destroy() end)
		return dist
	end

	local function rainUpdate(dt)
		local cfg = rain.cfg
		local cam = workspace.CurrentCamera
		if not cfg or not cam or not rain.folder then return end
		local cp = cam.CFrame.Position
		for _, l in ipairs(rain.layers) do l.part.CFrame = CFrame.new(cp + Vector3.new(0, l.h, 0)) end
		if rain.splash then
			if rain.gy then rain.splash.part.CFrame = CFrame.new(cp.X, rain.gy + 0.15, cp.Z) end
		end
		-- ust/alt kontrolu: tavan varsa yagmur kapanir, zemin yuksekligi sicramalar icin bulunur
		rain.chk = rain.chk - dt
		if rain.chk <= 0 then
			rain.chk = 0.3
			local ign = { cam }
			if lp.Character then table.insert(ign, lp.Character) end
			rainRP.FilterDescendantsInstances = ign
			local up = workspace:Raycast(cp, Vector3.new(0, 90, 0), rainRP)
			local down = workspace:Raycast(cp, Vector3.new(0, -250, 0), rainRP)
			rain.gy = down and down.Position.Y or nil
			local was = rain.covered
			rain.covered = up ~= nil and up.Instance.Transparency < 0.9
			for _, l in ipairs(rain.layers) do l.em.Enabled = not rain.covered end
			if rain.splash then rain.splash.em.Enabled = (not rain.covered) and rain.gy ~= nil end
			if was ~= rain.covered and snd.loop then
				tween(snd.loop, 0.5, { Volume = volTarget() })
				if snd.eq then tween(snd.eq, 0.5, { HighGain = rain.covered and -25 or 0 }) end
			end
		end
		if cfg.distant then
			rain.thT = rain.thT - dt
			if rain.thT <= 0 then
				rain.thT = 30 + math.random() * 40
				pcall(playThunder, true)
			end
		end
		local show = SKY.Screen and not rain.covered
		if cfg.lightning and SKY.Lightning then
			rain.boltT = rain.boltT - dt
			if rain.boltT <= 0 then
				rain.boltT = 7 + math.random() * 13
				local ok, dist = pcall(rainBolt)
				if not ok then dist = 700 end
				if show then rainFlash() end
				if rain.exp0 then
					Lighting.ExposureCompensation = rain.exp0 + 1.4
					tween(Lighting, 0.5, { ExposureCompensation = rain.exp0 })
				end
				task.delay(dist / 420 + math.random() * 0.4, function()
					if rain.cfg then pcall(playThunder, false) end
				end)
			end
		end
		if rain.root then rain.root.Visible = show end
		if not show then return end
		local vp = cam.ViewportSize
		for _, s in ipairs(rain.streaks) do
			s.y = s.y + s.sp * dt
			s.x = s.x + s.dx * dt
			if s.y > vp.Y + 60 then
				s.y = -60
				s.x = math.random() * vp.X
			end
			if s.x > vp.X + 60 then s.x = -40 end
			s.f.Position = UDim2.fromOffset(s.x, s.y)
		end
		-- lens damlalari: belirir, yavasca kayar, solar
		rain.spawn = rain.spawn - dt
		if rain.spawn <= 0 then
			rain.spawn = (0.35 / math.max(0.2, cfg.amount * SKY.Density)) * (0.6 + math.random() * 0.8)
			if #rain.drops < math.floor(36 * cfg.amount) then rainDrop(vp) end
		end
		for i = #rain.drops, 1, -1 do
			local d = rain.drops[i]
			d.age = d.age + dt
			if d.age >= d.life then
				d.f:Destroy()
				table.remove(rain.drops, i)
			else
				d.vy = d.vy + (d.age > d.life * 0.45 and 14 or 3) * dt * math.random()
				d.y = d.y + d.vy * dt
				d.f.Position = UDim2.fromOffset(d.f.Position.X.Offset, d.y)
				local left = d.life - d.age
				local fade = left < 1.2 and (1 - left / 1.2) or 0
				d.f.BackgroundTransparency = 0.85 + 0.15 * fade
				d.st.Transparency = 0.5 + 0.5 * fade
			end
		end
	end

	local function reset()
		SKY.Cur = nil
		SKY.Name = "Default"
		SKY.over = {}
		fxClear()
		rainClear()
		nebClear()
		unClouds()
		for _, n in ipairs({ "AuroraSky_Atmo", "AuroraSky_CC", "AuroraSky_Bloom", "AuroraSky_Rays", "AuroraSky_Sky" }) do
			local o = Lighting:FindFirstChild(n)
			if o then o:Destroy() end
		end
		for _, h in ipairs(hidden) do
			if h[1] and h[2] then pcall(function() h[1].Parent = h[2] end) end
		end
		hidden = {}
		if orig then
			Lighting.Ambient = orig.Ambient
			Lighting.OutdoorAmbient = orig.OutdoorAmbient
			Lighting.ColorShift_Top = orig.Top
			Lighting.ColorShift_Bottom = orig.Bot
			Lighting.FogColor = orig.FogColor
			Lighting.FogStart = orig.FogStart
			Lighting.FogEnd = orig.FogEnd
			Lighting.Brightness = orig.Brightness
			Lighting.ExposureCompensation = orig.Exposure
			Lighting.ClockTime = orig.ClockTime
		end
		enforcedAmbient = nil
		enforcedClockTime = nil
	end

	local function setPreset(name)
		if name == "Default" or not PRESETS[name] then
			reset()
			return
		end
		save()
		if #hidden == 0 then hideForeign() end
		local p = PRESETS[name]
		SKY.Cur = p
		SKY.Name = name
		applyLight(p)
		fxBuild(p)
		rainBuild(p)
		nebBuild(DETAIL[name])
	end

	-- oyun ayarlari ezmesin diye ayarlari yarim saniyede bir tekrar uygula; parcaciklar kamerayi takip eder
	table.insert(conns, RunService.Heartbeat:Connect(function(dt)
		if not SKY.Cur then return end
		acc = acc + dt
		if rain.cfg then pcall(rainUpdate, dt) end
		if acc >= 0.5 then
			acc = 0
			pcall(applyLight, SKY.Cur)
			-- oyun kendi Sky/Atmosphere'ini geri koyduysa tekrar gizle (kendi gokyuzumuzun ustune binmesin)
			pcall(hideForeign)
			-- katman bir sekilde yok olduysa (oyun temizledi vb.) kendini yeniden kurar
			local dtl = DETAIL[SKY.Name]
			if SKY.Detail and dtl and os.clock() - lastNeb > 3 and (not nebPart or not nebPart.Parent or not nebPart:FindFirstChildOfClass("ParticleEmitter")) then
				lastNeb = os.clock()
				warn("[Aurora Sky] nebula layer rebuilt")
				pcall(nebBuild, dtl)
			end
		end
		if nebPart then
			local cam = workspace.CurrentCamera
			if cam then
				if nebPart.Parent ~= cam then nebPart.Parent = cam end
				if nebPart:GetAttribute("need") then nebPart:SetAttribute("need", nil) nebPrefill() end
				local cp = cam.CFrame.Position
				local clk = os.clock()
				-- katmanlar kameraya sabit ama cok yavas ve farkli hizlarda doner: canli bir gokyuzu hissi
				nebPart.CFrame = CFrame.new(cp + Vector3.new(0, nebPart:GetAttribute("h") or 300, 0)) * CFrame.Angles(0, clk * 0.006, 0)
				if nebLow then nebLow.CFrame = CFrame.new(cp + Vector3.new(0, 60, 0)) * CFrame.Angles(0, -clk * 0.004, 0) end
				if nebGlit then nebGlit.CFrame = CFrame.new(cp + Vector3.new(0, 250, 0)) * CFrame.Angles(0, clk * 0.003, 0) end
			end
		end
		if SKY.Shooting and SKY.Detail and (SKY.over.stars or SKY.Cur.stars or 0) > 0 then
			shootT = shootT - dt
			if shootT <= 0 then
