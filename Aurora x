	end)
end

-- FOV KILIDI: kosma, nisan alma, silah/durbun gibi oyun scriptleri FOV'u degistirse bile secilen deger geri yazilir
local FovLock = { On = true, Value = nil }
do
	local boundCam, conn = nil, nil
	local function hook(cam)
		if conn then conn:Disconnect() conn = nil end
		boundCam = cam
		if not cam then return end
		-- oyun FOV'u her degistirdiginde aninda geri yaz (cizimden once)
		conn = cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
			if FovLock.On and FovLock.Value and boundCam and boundCam.FieldOfView ~= FovLock.Value then
				boundCam.FieldOfView = FovLock.Value
			end
		end)
	end
	hook(workspace.CurrentCamera)
	table.insert(conns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function() hook(workspace.CurrentCamera) end))
	pcall(function() RunService:UnbindFromRenderStep("AuroraFovLock") end)
	-- en son calisan render adimi: oyunun kamera scriptlerinden sonra bir kez daha uygula
	RunService:BindToRenderStep("AuroraFovLock", Enum.RenderPriority.Last.Value, function()
		local cam = workspace.CurrentCamera
		if cam ~= boundCam then hook(cam) end
		if FovLock.On and FovLock.Value and cam and cam.FieldOfView ~= FovLock.Value then
			cam.FieldOfView = FovLock.Value
		end
	end)
end

