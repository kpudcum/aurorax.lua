	local function save()
		if orig then return end
		orig = { Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient, Top = Lighting.ColorShift_Top, Bot = Lighting.ColorShift_Bottom,
			FogColor = Lighting.FogColor, FogStart = Lighting.FogStart, FogEnd = Lighting.FogEnd, Brightness = Lighting.Brightness,
			Exposure = Lighting.ExposureCompensation, ClockTime = Lighting.ClockTime }
	end
	local function ensure(class, name)
		local o = Lighting:FindFirstChild(name)
		if o and not o:IsA(class) then o:Destroy() o = nil end
		if not o then
			o = Instance.new(class)
			o.Name = name
			o.Parent = Lighting
		end
		return o
	end
	local function hideForeign()
		for _, o in ipairs(Lighting:GetChildren()) do
			if (o:IsA("Sky") or o:IsA("Atmosphere")) and string.sub(o.Name, 1, 10) ~= "AuroraSky_" then
				table.insert(hidden, { o, o.Parent })
				o.Parent = nil
			end
		end
	end

	local function cloudsOf(create)
		local terrain = workspace:FindFirstChildOfClass("Terrain")
		if not terrain then return nil end
		local cl = terrain:FindFirstChildOfClass("Clouds")
		if not cl and create then
			cl = Instance.new("Clouds")
			cl.Name = "AuroraSky_Clouds"
			cl.Parent = terrain
		end
		return cl
	end
	local function unClouds()
		local cl = cloudsOf(false)
		if not cl then cloudOrig = nil return end
		if cl.Name == "AuroraSky_Clouds" then
			cl:Destroy()
		elseif cloudOrig and cloudOrig[1] == cl then
			pcall(function()
				cl.Cover, cl.Density, cl.Color, cl.Enabled = cloudOrig[2], cloudOrig[3], cloudOrig[4], cloudOrig[5]
			end)
		end
		cloudOrig = nil
	end
	local function applyClouds(dt)
		if not SKY.Detail or not dt then return end
		local cl = cloudsOf(true)
		if not cl then return end
		if cl.Name ~= "AuroraSky_Clouds" and not cloudOrig then
			cloudOrig = { cl, cl.Cover, cl.Density, cl.Color, cl.Enabled }
		end
		cl.Enabled = true
		cl.Cover = SKY.over.cover or dt.cover
		cl.Density = dt.den
		cl.Color = dt.col
	end

	local function nebClear()
		if nebPart then nebPart:Destroy() end
		nebPart, nebLow, nebGlit = nil, nil, nil
	end
	-- emitter ancak dunyaya (kameraya) baglandiktan sonra parcacik uretir: on doldurma bu yuzden parent'tan SONRA yapilir
	local function nebPrefill()
		for _, p in ipairs({ nebPart, nebLow, nebGlit }) do
			local em = p and p:FindFirstChildOfClass("ParticleEmitter")
			if em then pcall(function() em:Emit(math.floor(em.Rate * 12)) end) end
		end
	end
	local function nebBuild(dt)
		nebClear()
		if not dt or not SKY.Detail then return end
		local function layer(name, sx, sy, rateMul, sizeMul, tr, ca, cb)
			local part = Instance.new("Part")
			part.Name = name
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Transparency = 1
			part.Size = Vector3.new(sx, sy, sx)
			local em = Instance.new("ParticleEmitter")
			em.Texture = "rbxasset://textures/particles/smoke_main.dds"
			local mid = dt.c3 or ca:Lerp(cb, 0.5)
			em.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, ca), ColorSequenceKeypoint.new(0.5, mid), ColorSequenceKeypoint.new(1, cb) })
			local sz = dt.size * sizeMul
			em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, sz, sz * 0.4), NumberSequenceKeypoint.new(1, sz, sz * 0.4) })
			em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, tr), NumberSequenceKeypoint.new(0.75, tr), NumberSequenceKeypoint.new(1, 1) })
			em.Lifetime = NumberRange.new(16, 28)
			em.Speed = NumberRange.new(0, 0.4)
			em.Rate = dt.rate * rateMul
			em.Rotation = NumberRange.new(0, 360)
			em.RotSpeed = NumberRange.new(-1, 1)
			em.LightEmission = dt.flat and dt.light or math.max(dt.light, 0.5)
			em.LightInfluence = 0
			em.LockedToPart = true
			em.Shape = Enum.ParticleEmitterShape.Box
			em.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			em.Parent = part
			return part
		end
		-- ust katman (tepe) + ufuk katmani: yakin ve belirgin renk, tum gokyuzunu boyar
		local top = layer("AuroraSkyNebula", 1300, 300, 3.2, 0.8, math.max(0.45, dt.tr - 0.3), dt.c1, dt.c2)
		top:SetAttribute("h", 300)
		top.Parent = workspace.CurrentCamera
		local low = layer("AuroraSkyNebulaLow", 1500, 50, 4, 0.7, math.max(0.4, dt.tr - 0.38), dt.c2, dt.c1)
		low.Parent = top
		-- gece gokyuzlerinde: parlayan yildiz tozu katmani
		local pp = PRESETS[SKY.Name]
		local gl = nil
		if pp and (SKY.over.stars or pp.stars or 0) > 0 then
			gl = Instance.new("Part")
			gl.Name = "AuroraSkyGlitter"
			gl.Anchored = true
			gl.CanCollide = false
			gl.CanQuery = false
			gl.CanTouch = false
			gl.CastShadow = false
			gl.Transparency = 1
			gl.Size = Vector3.new(1300, 500, 1300)
			local ge = Instance.new("ParticleEmitter")
			ge.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			ge.Color = ColorSequence.new(Color3.new(1, 1, 1), dt.c1:Lerp(Color3.new(1, 1, 1), 0.5))
			ge.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 10, 6), NumberSequenceKeypoint.new(1, 10, 6) })
			ge.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.1), NumberSequenceKeypoint.new(0.8, 0.1), NumberSequenceKeypoint.new(1, 1) })
			ge.Lifetime = NumberRange.new(10, 18)
			ge.Speed = NumberRange.new(0, 0.2)
			ge.Rate = 8
			ge.Rotation = NumberRange.new(0, 360)
			ge.RotSpeed = NumberRange.new(-20, 20)
			ge.LightEmission = 1
			ge.LightInfluence = 0
			ge.LockedToPart = true
			ge.Shape = Enum.ParticleEmitterShape.Box
			ge.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			ge.Parent = gl
			gl.Parent = top
		end
		nebPart, nebLow, nebGlit = top, low, gl
		if top.Parent then nebPrefill() else top:SetAttribute("need", true) end
	end

	-- kayan yildiz: kameranin etrafinda rastgele bir yonde, uzakta hizla gecen parlak bir iz
	local function shoot()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local cp = cam.CFrame.Position
		local ang = math.random() * math.pi * 2
		local startP = cp + Vector3.new(math.cos(ang) * 700, math.random(380, 650), math.sin(ang) * 700)
		local dir = Vector3.new(-math.sin(ang), -0.3, math.cos(ang)).Unit
		if math.random() < 0.5 then dir = -dir end
		local part = Instance.new("Part")
		part.Name = "AuroraShootingStar"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = Vector3.new(2, 2, 2)
		part.Position = startP
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 7, 0)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -7, 0)
		a1.Parent = part
		local tr = Instance.new("Trail")
		tr.Attachment0, tr.Attachment1 = a0, a1
		tr.Lifetime = 0.8
		tr.LightEmission = 1
		tr.LightInfluence = 0
		tr.FaceCamera = true
		tr.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 190, 255))
		tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		tr.Parent = part
		part.Parent = cam
		tween(part, 0.9, { Position = startP + dir * 520 }, Enum.EasingStyle.Linear)
		task.delay(2, function() part:Destroy() end)
	end

	local function applyLight(p)
		local tm = SKY.over.time
		if tm == nil and SKY.useTime then tm = p.time end
		if tm ~= nil then
			Lighting.ClockTime = tm
			enforcedClockTime = tm
		else
			enforcedClockTime = nil
		end
		Lighting.FogEnd = 100000
		Lighting.FogStart = 0
		local a = ensure("Atmosphere", "AuroraSky_Atmo")
		a.Density = SKY.over.dens or (p.atmo.d > 0 and math.max(p.atmo.d, 0.5) or 0)
		a.Offset = p.atmo.d > 0 and 0.15 or 0
		a.Color = SKY.over.acol or p.atmo.col
		a.Decay = SKY.over.dec or p.atmo.dec
		a.Glare = p.atmo.gl
		a.Haze = p.atmo.hz
		for _, n in ipairs({ "AuroraSky_CC", "AuroraSky_Bloom", "AuroraSky_Rays" }) do
			local o = Lighting:FindFirstChild(n)
			if o then o:Destroy() end
		end
		local sk = Lighting:FindFirstChild("AuroraSky_Sky")
		if sk and sk:GetAttribute("blank") ~= (p.blank and true or false) then sk:Destroy() end
		sk = ensure("Sky", "AuroraSky_Sky")
		sk:SetAttribute("blank", p.blank and true or false)
		sk.StarCount = SKY.over.stars or p.stars or 0
		sk.CelestialBodiesShown = true
		local dt = DETAIL[SKY.Name]
		pcall(function()
			sk.SunAngularSize = dt and dt.sun or 21
			sk.MoonAngularSize = dt and dt.moon or 11
		end)
		pcall(applyClouds, dt)
		if p.blank then
			sk.SkyboxBk = "" sk.SkyboxDn = "" sk.SkyboxFt = "" sk.SkyboxLf = "" sk.SkyboxRt = "" sk.SkyboxUp = ""
		end
	end

