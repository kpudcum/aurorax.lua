	local B64M = {}
	do
		local alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
		for i = 1, 64 do B64M[string.byte(alpha, i)] = i - 1 end
	end
	local function b64dec(s)
		local out, n, len, i = {}, 0, #s, 1
		while i <= len do
			local a, b, c, d = string.byte(s, i, i + 3)
			a, b = B64M[a], B64M[b]
			c = c and B64M[c]
			d = d and B64M[d]
			n = n + 1
			if c == nil then
				out[n] = string.char(math.floor((a * 64 + b) / 16))
			elseif d == nil then
				local v = math.floor((a * 4096 + b * 64 + c) / 4)
				out[n] = string.char(math.floor(v / 256), v % 256)
			else
				local v = a * 262144 + b * 4096 + c * 64 + d
				out[n] = string.char(math.floor(v / 65536), math.floor(v / 256) % 256, v % 256)
			end
			i = i + 4
		end
		return table.concat(out)
	end
	local snd = { tried = false, ok = false, ids = {}, loop = nil, eq = nil }
	local function loadSnd()
		if snd.tried then return snd.ok end
		snd.tried = true
		snd.ok = pcall(function()
			local gca = getcustomasset or getsynasset
			if not (writefile and gca) then error("no file api") end
			local names = { rain = "AuroraX_rain2.ogg", th1 = "AuroraX_th1.ogg", th2 = "AuroraX_th2.ogg", th3 = "AuroraX_th3.ogg", streak = "AuroraX_streak.png", splash = "AuroraX_splash.png" }
			for k, fn in pairs(names) do
				writefile(fn, b64dec(AUDIO[k]))
				snd.ids[k] = gca(fn)
			end
		end)
		AUDIO = nil
		return snd.ok
	end
