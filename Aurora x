					if d.Magnitude > 1 then d = d.Unit end
					FC.mv = d
					knob.Position = UDim2.new(0.5, d.X * 40, 0.5, d.Y * 40)
				elseif i == lookIn then
					FC.look = FC.look + Vector2.new(i.Delta.X, i.Delta.Y)
				end
			end))
			table.insert(conns2, UIS.InputEnded:Connect(function(i)
				if i == jIn then
					jIn = nil
					FC.mv = Vector2.new(0, 0)
					knob.Position = UDim2.fromScale(0.5, 0.5)
				elseif i == lookIn then
					lookIn = nil
				end
			end))
