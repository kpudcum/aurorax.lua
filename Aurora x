	-- mobil: sol joystick (hareket), sag tarafa surukle (bakis), yukari/asagi butonlari ve cikis
	local function buildUI()
		local cam0 = workspace.CurrentCamera
		local vp = cam0 and cam0.ViewportSize or Vector2.new(800, 400)
		local touch = UIS.TouchEnabled
		local sg = Instance.new("ScreenGui")
		sg.Name = "AuroraFreecamUI"
		sg.ResetOnSpawn = false
		sg.IgnoreGuiInset = true
		sg.DisplayOrder = 250
		sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		sg.Parent = host
		local conns2 = {}
		local function mk(cls, props, parent)
			local o = Instance.new(cls)
			for k, v in pairs(props) do o[k] = v end
			o.Parent = parent
			return o
		end
		local function rnd(o, r)
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, r)
			c.Parent = o
		end
		local function strk(o, col, th, tr)
			local s = Instance.new("UIStroke")
			s.Color = col
			s.Thickness = th
			s.Transparency = tr
			s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			s.Parent = o
			return s
		end
		local function txt(parent, t, size, z)
			return mk("TextLabel", { Text = t, Font = Enum.Font.GothamBold, TextSize = size, TextColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = z, TextXAlignment = Enum.TextXAlignment.Center }, parent)
		end
		local bg = Color3.fromRGB(18, 18, 28)
		local hintText = touch and "FREECAM  |  Left pad: move  |  Drag screen: look  |  Up / Down buttons"
			or ("FREECAM  |  WASD move  |  Space / Ctrl up-down  |  Shift fast  |  hold Right Mouse to look  |  " .. tostring(FC.Key.value and FC.Key.value.Name or "key") .. " to exit")
		local hint = mk("TextLabel", { Text = hintText, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), BackgroundColor3 = bg, BackgroundTransparency = 0.15, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(math.min(vp.X - 20, 620), 28), ZIndex = 20, BorderSizePixel = 0 }, sg)
		rnd(hint, 14)
		local hst = strk(hint, accent, 1.5, 0.2)
		table.insert(conns2, { Disconnect = function() end })
		onAccent(function(a) pcall(function() hst.Color = a end) end)
		task.delay(8, function()
			if hint.Parent then
				pcall(tween, hint, 0.8, { BackgroundTransparency = 0.8, TextTransparency = 0.5 })
			end
		end)
		-- cikis butonu (hem mobil hem PC)
		local ex = mk("TextButton", { Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(140, 32), Position = UDim2.new(0.5, 0, 0, 46), BackgroundColor3 = bg, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 30 }, sg)
		rnd(ex, 16)
		strk(ex, Color3.fromRGB(255, 107, 122), 1.5, 0.1)
		txt(ex, "EXIT FREECAM", 12, 31)
		table.insert(conns2, ex.Activated:Connect(function()
			if fcToggle then fcToggle.Set(false) else stopFC() end
		end))
		if touch then
			-- bakis alani: tum ekran, kontrollerin altinda
			local pad = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Active = true, ZIndex = 1, BorderSizePixel = 0 }, sg)
			local base = mk("Frame", { Size = UDim2.fromOffset(140, 140), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(105, vp.Y - 115), BackgroundColor3 = bg, BackgroundTransparency = 0.3, BorderSizePixel = 0, Active = true, ZIndex = 10 }, sg)
			rnd(base, 70)
			strk(base, accent, 2, 0.2)
			local knob = mk("Frame", { Size = UDim2.fromOffset(60, 60), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = accent, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 11 }, base)
			rnd(knob, 30)
			onAccent(function(a) pcall(function() knob.BackgroundColor3 = a end) end)
			local jIn, jStart, lookIn = nil, nil, nil
			table.insert(conns2, base.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.Touch and not jIn then
					jIn = i
					jStart = base.AbsolutePosition + base.AbsoluteSize / 2
				end
			end))
			table.insert(conns2, pad.InputBegan:Connect(function(i)
				if i.UserInputType == Enum.UserInputType.Touch and not lookIn then lookIn = i end
			end))
			table.insert(conns2, UIS.InputChanged:Connect(function(i)
