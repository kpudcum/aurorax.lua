local function finite(v) return type(v) == 'number' and v == v and math.abs(v) < 1e6 end
local function healthColor(r)
	return Color3.fromRGB(math.floor(235 * (1 - r) + 70 * r), math.floor(70 * (1 - r) + 225 * r), math.floor(85 * (1 - r) + 130 * r))
