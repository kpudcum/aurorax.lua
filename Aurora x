				local y = math.clamp(startPos.Y.Offset + d.Y, 0, math.max(0, v.Y - R.Size))
				root.Position = UDim2.fromOffset(x, y)
			end
		end))
		table.insert(conns, UIS.InputEnded:Connect(function(i)
			if i == dIn or i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
		end))
	end

	local function getDot(key)
		local d = dots[key]
		if d then return d end
		local f = new("Frame", { Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 44 })
		local cr = corner(999)
		cr.Parent = f
		stroke(Color3.fromRGB(0, 0, 0), 1, 0.4).Parent = f
		local t = label({ Text = "", TextSize = 9, Font = Enum.Font.GothamBold, TextColor3 = T.text, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(0, 70, 0, 10), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 1), ZIndex = 44 })
		t.TextStrokeTransparency = 0.5
		t.Parent = f
		f.Parent = root
		d = { f = f, t = t, c = cr, shape = 0, stamp = 0 }
		dots[key] = d
		return d
	end
	local function clearDots()
		for k, d in pairs(dots) do d.f:Destroy() dots[k] = nil end
	end

	local function place(key, rootPart, fwd, right, mine, col, name)
		if not rootPart or not rootPart.Parent then return end
		local rel = rootPart.Position - mine
		local x, y = rel:Dot(right), rel:Dot(fwd)
		local dist = math.sqrt(x * x + y * y)
		local rad = R.Size / 2 - 7
		-- karekok olcek: menzil buyuse bile yakindaki oyuncular merkeze yigilmaz, aralarindaki fark okunur
		local sc = math.sqrt(math.min(dist, R.Range) / R.Range)
		local nx, ny = 0, 0
		if dist > 0.001 then nx, ny = x / dist, y / dist end
		local d = getDot(key)
		d.stamp = frameId
		d.f.Position = UDim2.new(0.5, nx * sc * rad, 0.5, -ny * sc * rad)
		d.f.BackgroundColor3 = col
		d.f.BackgroundTransparency = dist > R.Range and 0.55 or 0
		-- sekil yukseklik farkini gosterir: elmas = yukarida, kare = asagida, daire = ayni seviye; yakindakiler buyuk
		local dy = rootPart.Position.Y - mine.Y
		local shape = dy > 10 and 1 or (dy < -10 and 2 or 3)
		if d.shape ~= shape then
			d.shape = shape
			d.c.CornerRadius = shape == 3 and UDim.new(0, 999) or (shape == 2 and UDim.new(0, 2) or UDim.new(0, 0))
			d.f.Rotation = shape == 1 and 45 or 0
		end
		local ds = dist < 40 and 10 or 7
		d.f.Size = UDim2.fromOffset(ds, ds)
		d.f.Visible = true
		d.t.Visible = R.Names
		if R.Names then d.t.Text = name or "" end
		return dist
	end

	local function update(dt)
		local cam = workspace.CurrentCamera
		local char = lp.Character
		local myRoot = char and char:FindFirstChild("HumanoidRootPart")
		sweep.Rotation = (os.clock() * 110) % 360
		if not cam or not myRoot then
			for _, d in pairs(dots) do d.f.Visible = false end
			return
		end
		frameId = frameId + 1
		local fwd, right = Vector3.new(0, 0, -1), Vector3.new(1, 0, 0)
		if R.Rot then
			local lv = cam.CFrame.LookVector
			local flat = Vector3.new(lv.X, 0, lv.Z)
			if flat.Magnitude > 0.01 then
				fwd = flat.Unit
				right = fwd:Cross(Vector3.new(0, 1, 0))
			end
		end
		local mine = myRoot.Position
		local lv0 = cam.CFrame.LookVector
		local yaw = math.atan2(lv0.X, -lv0.Z)
		local vpz = cam.ViewportSize
		local hf = 2 * math.atan(math.tan(math.rad(cam.FieldOfView) / 2) * (vpz.X / math.max(1, vpz.Y)))
		local half = R.Size / 2
		local cl = half - 8
		local base = R.Rot and 0 or yaw
		for i = 1, 2 do
			local th = base + (i == 1 and -hf / 2 or hf / 2)
			cones[i].Size = UDim2.fromOffset(1, cl)
			cones[i].Position = UDim2.new(0.5, math.sin(th) * cl / 2, 0.5, -math.cos(th) * cl / 2)
			cones[i].Rotation = math.deg(th)
		end
		local nth = R.Rot and -yaw or 0
		northLbl.Position = UDim2.new(0.5, math.sin(nth) * (half - 9), 0.5, -math.cos(nth) * (half - 9))
		local near, nearName = math.huge, ""
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= lp then
				local c = pl.Character
				local hum = c and c:FindFirstChildOfClass("Humanoid")
				local rt = c and c:FindFirstChild("HumanoidRootPart")
				if hum and rt and hum.Health > 0 then
					local mate = lp.Team ~= nil and not lp.Neutral and pl.Team == lp.Team
					if not mate or (R.Team and not ESP.TeamCheck) then
						local col = mate and Color3.fromRGB(80, 225, 140) or (ESP.Rainbow and rainbow or Color3.fromRGB(255, 80, 95))
						local dd = place(pl, rt, fwd, right, mine, col, pl.DisplayName)
						if dd and not mate and dd < near then near, nearName = dd, pl.DisplayName end
					end
				end
			end
		end
		if R.NPC then
			for m in pairs(npcs) do
				local hum = m.Parent and m:FindFirstChildOfClass("Humanoid")
				local rt = m.Parent and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
				if hum and rt and hum.Health > 0 then
					place(m, rt, fwd, right, mine, Color3.fromRGB(255, 190, 70), m.Name)
				end
			end
		end
		for k, d in pairs(dots) do
			if d.stamp ~= frameId then d.f:Destroy() dots[k] = nil end
		end
		nearLbl.Text = near < math.huge and (nearName .. " " .. math.floor(near) .. " st") or ""
	end

	local function setOn(on)
		R.On = on
		if hbConn then hbConn:Disconnect() hbConn = nil end
		if on then
			root.Visible = true
			root.BackgroundTransparency = 1
			tween(root, 0.3, { BackgroundTransparency = 0.12 })
			hbConn = RunService.Heartbeat:Connect(update)
		else
			root.Visible = false
			clearDots()
		end
	end
	gui.Destroying:Connect(function()
		if hbConn then hbConn:Disconnect() hbConn = nil end
	end)
	root.Parent = gui

	eRad:AddToggle("Radar", false, function(on) setOn(on) end)
