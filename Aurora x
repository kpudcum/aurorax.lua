				sw.Parent = head
				local satG, valG
				-- doygunluk / parlaklik cubuklari secili tona gore renklenir
				local function tintBars()
					if satG then satG.Color = ColorSequence.new(Color3.fromHSV(h, 0, 1), Color3.fromHSV(h, 1, 1)) end
					if valG then valG.Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.fromHSV(h, s, 1)) end
				end
				local function apply()
					local c = Color3.fromHSV(h, s, v)
					sw.BackgroundColor3 = c
					tintBars()
					if cb then cb(c) end
				end
				local function bar(y, seq, onRel)
					local grad = new("UIGradient", { Color = seq })
					local tr = new("Frame", { Size = UDim2.new(1, -28, 0, 10), Position = UDim2.fromOffset(14, y), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(5), grad })
					local k = new("Frame", { Size = UDim2.fromOffset(6, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, { corner(3), stroke(Color3.new(0, 0, 0), 1, 0.4) })
					k.Parent = tr
					tr.Parent = r
					makeDrag(tr, function(rel) k.Position = UDim2.fromScale(rel, 0.5) onRel(rel) end)
					return k, grad
