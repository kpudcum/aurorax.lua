	-- Sekme adina gore secilir (adi icinde anahtar kelime gecenler de eslesir).
	local ICON_KEYS = {
		{ "home", "home" }, { "player", "player" }, { "server", "server" }, { "visual", "visuals" }, { "esp", "esp" },
		{ "aim", "aimbot" }, { "hit", "hitbox" }, { "setting", "settings" }, { "config", "settings" }, { "teleport", "teleport" },
	}
	local function tabIconKind(tabName)
		local lower = string.lower(tabName or "")
		for _, k in ipairs(ICON_KEYS) do
			if string.find(lower, k[1], 1, true) then return k[2] end
		end
		return nil
	end

	-- 20x20 alana simge cizer, renk degistirme fonksiyonu dondurur
	local function buildTabIcon(kind, parent)
		local fills, strokes = {}, {}
		local box = new("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1 })
		local function round(f, r)
			if r == "c" then
				new("UICorner", { CornerRadius = UDim.new(0.5, 0) }).Parent = f
			elseif r then
				new("UICorner", { CornerRadius = UDim.new(0, r) }).Parent = f
			end
		end
		local function rect(x, y, w, h, r, rot, alpha) -- dolu parca (alpha: yari saydam ikinci ton)
			local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundColor3 = T.dim, BackgroundTransparency = alpha or 0, BorderSizePixel = 0, Rotation = rot or 0 })
			round(f, r)
			f.Parent = box
			table.insert(fills, f)
		end
		local function ring(x, y, w, h, r, thick, alpha) -- cizgi (ici bos) parca
			local f = new("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, BorderSizePixel = 0 })
			round(f, r)
			local st = new("UIStroke", { Thickness = thick or 1.6, Color = T.dim, Transparency = alpha or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
			st.Parent = f
			f.Parent = box
			table.insert(strokes, st)
		end

		if kind == "home" then
			rect(3, 9, 14, 9, 3, 0, 0.55)
			rect(5, 2.5, 10, 10, 2, 45)
			rect(8, 12, 4, 6, 1.5)
		elseif kind == "player" then
			rect(6.5, 1, 7, 7, "c")
			rect(3, 11, 14, 8, 4, 0, 0.55)
			ring(3, 11, 14, 8, 4, 1.4)
		elseif kind == "visuals" then
			ring(1, 4, 18, 12, 6, 1.6)
			ring(6.5, 6.5, 7, 7, "c", 1.4, 0.45)
			rect(8.5, 8.5, 3, 3, "c")
		elseif kind == "esp" then
			rect(1, 1, 6, 2, 1) rect(1, 1, 2, 6, 1)
			rect(13, 1, 6, 2, 1) rect(17, 1, 2, 6, 1)
			rect(1, 17, 6, 2, 1) rect(1, 13, 2, 6, 1)
			rect(13, 17, 6, 2, 1) rect(17, 13, 2, 6, 1)
			ring(6, 6, 8, 8, "c", 1.4, 0.5)
			rect(9, 9, 2, 2, "c")
		elseif kind == "aimbot" then
			ring(3, 3, 14, 14, "c", 1.6)
			ring(6.5, 6.5, 7, 7, "c", 1.2, 0.5)
			rect(9.2, 0, 1.6, 4, 1) rect(9.2, 16, 1.6, 4, 1)
			rect(0, 9.2, 4, 1.6, 1) rect(16, 9.2, 4, 1.6, 1)
			rect(9, 9, 2, 2, "c")
		elseif kind == "hitbox" then
			ring(7, 1.5, 11, 11, 2.5, 1.4, 0.5)
			rect(2, 7.5, 11, 11, 2.5, 0, 0.8)
			ring(2, 7.5, 11, 11, 2.5, 1.7)
		elseif kind == "teleport" then
			ring(4, 1, 12, 18, "c", 1.6)
			ring(7, 5, 6, 10, "c", 1.3, 0.5)
			rect(9, 9, 2, 2, "c")
			rect(0, 9, 3, 2, 1)
			rect(17, 9, 3, 2, 1, 0, 0.5)
		elseif kind == "settings" then
			rect(2, 3, 16, 2, 1, 0, 0.55) rect(2, 9, 16, 2, 1, 0, 0.55) rect(2, 15, 16, 2, 1, 0, 0.55)
			rect(10, 1, 6, 6, "c") rect(4, 7, 6, 6, "c") rect(11, 13, 6, 6, "c")
		elseif kind == "server" then
			rect(1, 1, 18, 5, 1.5, 0, 0.55) rect(1, 7.5, 18, 5, 1.5, 0, 0.55) rect(1, 14, 18, 5, 1.5, 0, 0.55)
			rect(15.3, 2.5, 2, 2, "c") rect(15.3, 9, 2, 2, "c") rect(15.3, 15.5, 2, 2, "c")
		end

		box.Parent = parent
		return function(c)
			for _, f in ipairs(fills) do f.BackgroundColor3 = c end
			for _, st in ipairs(strokes) do st.Color = c end
		end
	end

	function Window:AddTab(name, glyph)
		local btn = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = #tabList:GetChildren() })
		local bg = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = accent, BackgroundTransparency = 1, BorderSizePixel = 0 }, { corner(11) })
		onAccent(function(a) bg.BackgroundColor3 = a end)
		bg.Parent = btn
		local bar = new("Frame", { Size = UDim2.fromOffset(3, 0), Position = UDim2.fromOffset(-12, 20), BackgroundColor3 = accent, BorderSizePixel = 0 }, { corner(2) })
		onAccent(function(a) bar.BackgroundColor3 = a end)
		bar.Parent = btn
		local g = label({ Text = "", Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(34, 40), Position = UDim2.fromOffset(4, 0) })
		g.Parent = btn
		local ikind = tabIconKind(name)
		if ikind then
			-- cizilmis simge: glyph etiketinin rengi (secili/degil/vurgu) simgeyi de boyar
			local setIc = buildTabIcon(ikind, g)
			setIc(g.TextColor3)
			g:GetPropertyChangedSignal("TextColor3"):Connect(function() setIc(g.TextColor3) end)
		else
			g.Text = (glyph and glyph ~= "" and glyph ~= "o") and glyph or string.upper(string.sub(name or "?", 1, 1))
		end
		local tx = label({ Text = T_(name), Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = T.sub, Size = UDim2.new(1, -44, 1, 0), Position = UDim2.fromOffset(40, 0) })
		tx.Parent = btn
		regT(tx, name)
		onAccent(function(a) if current == name then g.TextColor3 = a end end)
		btn.MouseEnter:Connect(function() if current ~= name then tween(bg, 0.15, { BackgroundTransparency = 0.93 }) end end)
		btn.MouseLeave:Connect(function() if current ~= name then tween(bg, 0.15, { BackgroundTransparency = 1 }) end end)
		btn.MouseButton1Click:Connect(function() selectTab(name) end)
		btn.Parent = tabList
		tabBtns[name] = { bg = bg, text = tx, glyph = g, bar = bar }

		local page = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ClipsDescendants = true })
		local scroll = new("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = T.scroll, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, { pad(18, 16, 18, 16), list(14) })
		onThemeChange(function(k, c) if k == "scroll" then scroll.ScrollBarImageColor3 = c end end)
		scroll.Parent = page
		page.Parent = pagesHolder
		tabs[name] = page
		if not firstName then
