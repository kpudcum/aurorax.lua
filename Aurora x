	local function fxBuild(p)
		fxClear()
		if not p or not p.fx or not SKY.Particles then return end
		local f = p.fx
		local part = Instance.new("Part")
		part.Name = "AuroraSkyFX"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Transparency = 1
		part.Size = Vector3.new(80, 1, 80)
		local em = Instance.new("ParticleEmitter")
		em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		em.Color = ColorSequence.new(f.c1, f.c2)
		em.Size = NumberSequence.new(f.size)
		em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, f.tr), NumberSequenceKeypoint.new(0.85, f.tr), NumberSequenceKeypoint.new(1, 1) })
		em.Lifetime = NumberRange.new(f.life * 0.8, f.life * 1.2)
		em.Speed = NumberRange.new(f.speed * 0.7, f.speed * 1.3)
		em.Rate = f.rate * SKY.Density
		em.Acceleration = f.acc
		em.EmissionDirection = f.up and Enum.NormalId.Top or Enum.NormalId.Bottom
		em.SpreadAngle = Vector2.new(f.spread, f.spread)
		em.Rotation = NumberRange.new(0, 360)
		em.RotSpeed = NumberRange.new(-60, 60)
		em.LightEmission = f.light
		em.LockedToPart = false
		em.Parent = part
		part.Parent = workspace.CurrentCamera
		fxPart, fxEm = part, em
		fxPart:SetAttribute("up", f.up and true or false)
	end

